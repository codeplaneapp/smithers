{
  "name": "@smithers-orchestrator/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end fault-injection matrix and soak suite for the smithers orchestrator (ticket 0022).",
  "scripts": {
    "test": "bun test",
    "test:faults": "node ../scripts/check-fault-skips.mjs && bun test faults",
    "test:soak": "node ../scripts/check-fault-skips.mjs && SMITHERS_E2E_SOAK=1 bun test faults",
    "test:browser:install": "pnpm exec playwright install chromium",
    "test:browser:types": "tsc -p browser/tsconfig.json",
    "test:browser": "node browser/run-browser.mjs",
    "test:browser:package": "node browser/packed-consumer.mjs",
    "test:runtime:browser": "pnpm run test:browser:types && pnpm run test:browser:package && pnpm run test:browser",
    "test:runtime:worker:types": "tsc -p runtime/tsconfig.worker.json",
    "test:runtime:node": "node runtime/run-node.mjs",
    "test:runtime:bun": "bun runtime/run-bun.mjs",
    "test:runtime:cloudflare": "pnpm run test:runtime:worker:types && node runtime/run-cloudflare.mjs",
    "test:runtime:vercel": "node runtime/run-vercel.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smithers-orchestrator/db": "workspace:*",
    "@smithers-orchestrator/driver": "workspace:*",
    "@smithers-orchestrator/engine": "workspace:*",
    "@smithers-orchestrator/gateway": "workspace:*",
    "@smithers-orchestrator/gateway-client": "workspace:*",
    "@smithers-orchestrator/observability": "workspace:*",
    "@smithers-orchestrator/sandbox": "workspace:*",
    "@smithers-orchestrator/scheduler": "workspace:*",
    "@smithers-orchestrator/server": "workspace:*",
    "@smithers-orchestrator/testing": "workspace:*",
    "@smithers-orchestrator/time-travel": "workspace:*",
    "@smithers-orchestrator/vcs": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "effect": "3.21.4",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "smithers-orchestrator": "workspace:*",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260701.1",
    "@effect/platform-bun": "^0.90.0",
    "@smithers-orchestrator/errors": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "@vercel/node": "5.5.6",
    "typescript": "~6.0.3",
    "wrangler": "4.106.0"
  }
}
