{
  "name": "smithers-workflows",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests/open-code-review.test.ts ./tests/open-code-review-ui.e2e.test.ts ./tests/ddd-scripts.test.ts ./tests/ddd-ui-parsers.test.ts ./tests/ddd-generate-bug-scan.test.ts ./tests/docs-driven-development-workflow.test.ts ./tests/release-content-probe.test.ts ./tests/release-content-sidebar.test.ts ./ui/ddd-tabs.test.tsx ./ui/delegation-chain/dc-ui.test.tsx ./lib/plue-provider.test.ts",
    "lint": "oxlint --react-plugin --node-plugin --import-plugin --ignore-path ../.gitignore .",
    "lint:fix": "oxlint --react-plugin --node-plugin --import-plugin --ignore-path ../.gitignore --fix .",
    "workflow:list": "smithers workflow list",
    "workflow:run": "smithers workflow run",
    "workflow:implement": "smithers workflow run implement",
    "release:content": "cd .. && pnpm release:content",
    "release:content:approve": "cd .. && pnpm release:content:approve",
    "release:content:publish": "cd .. && pnpm release:content:publish",
    "release:workflow": "cd .. && pnpm release:workflow",
    "release:workflow:gated": "cd .. && pnpm release:workflow:gated",
    "marketing:thread": "cd .. && pnpm marketing:thread",
    "marketing:thread:write": "cd .. && pnpm marketing:thread:write",
    "test:open-code-review": "bun test ./tests/open-code-review.test.ts ./tests/open-code-review-ui.e2e.test.ts",
    "test:ddd": "bun test ./tests/docs-driven-development-run.e2e.test.ts ./tests/ddd-bug-scan-run.e2e.test.ts ./tests/ddd-generate-docs-run.e2e.test.ts ./tests/docs-driven-development-ui.e2e.test.tsx ./tests/ultragrill.e2e.test.ts",
    "test:ddd:browser": "bun test ./tests/ship-pipeline-run.e2e.test.ts ./tests/ship-pipeline-ui.e2e.test.tsx"
  },
  "dependencies": {
    "@milkdown/crepe": "7.21.2",
    "@smithers-orchestrator/cli": "workspace:*",
