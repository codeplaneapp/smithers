# pnpm's default public-hoist-pattern, kept because naming the setting replaces
# the default rather than adding to it.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

# Interim: the vendored flows aliases are declared by vendor/flows, a pnpm-only
# workspace package. Public-hoisting them into the root node_modules is what lets
# any package in the repository `import ... from "@flows/flow"`.
# See vendor/flows/README.md.
public-hoist-pattern[]=@flows/*
