{
  "sourcesPath": "config/sources.json",
  "dbPath": "data/ceo-intel.sqlite",
  "reportsDir": "reports",
  "cheapPoolName": "ceoIntelCheap",
  "strongPoolName": "ceoIntelStrong",
  "criticalSourceIds": ["openai-blog", "cloudflare-blog"],
  "assessBatchSize": 12,
  "maxTopStories": 8,
  "maxActions": 3,
  "lighterSideMin": 3,
  "lighterSideMax": 6,
  "composeWordMin": 800,
  "composeWordMax": 1400,
  "fingerprintRetentionDays": 30,
  "weights": {
    "smithersImpact": 30,
    "strategicRelevance": 20,
    "actionability": 20,
    "urgency": 10,
    "novelty": 10,
    "confidence": 10
  },
  "cloudflare": {
    "accountIdEnv": "CLOUDFLARE_ACCOUNT_ID",
    "apiTokenEnv": "CLOUDFLARE_API_TOKEN",
    "kvNamespaceIdEnv": "CLOUDFLARE_KV_NAMESPACE_ID",
    "r2BucketEnv": "CLOUDFLARE_R2_BUCKET"
  }
}
