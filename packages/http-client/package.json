{
  "name": "@smithers-orchestrator/http-client",
  "version": "0.28.0",
  "description": "Dependency-free outbound HTTP safety primitives for Smithers runtimes",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "import": "./src/node.js",
      "default": "./src/node.js"
    }
  },
  "files": [
    "src/",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dts.mjs src && tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  }
}
