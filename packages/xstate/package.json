{
  "name": "@smthrs/xstate",
  "version": "0.35.0",
  "description": "XState v5 machines as durable derived control state for Smithers workflows: pure folds over output and signal rows",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "rm -f src/index.d.ts && tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smthrs/errors": "workspace:*",
    "@smthrs/react-reconciler": "workspace:*",
    "react": "^19.2.7"
  },
  "peerDependencies": {
    "xstate": "^5.19.0"
  },
  "peerDependenciesMeta": {
    "xstate": {
      "optional": true
    }
  },
  "devDependencies": {
    "@smthrs/db": "workspace:*",
    "@smthrs/driver": "workspace:*",
    "@smthrs/engine": "workspace:*",
    "@smthrs/time-travel": "workspace:*",
    "@types/bun": "latest",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.105",
    "smthrs": "workspace:*",
    "typescript": "~6.0.3",
    "xstate": "5.32.5",
    "zod": "^4.4.3"
  }
}
