{
  "name": "@smithers-orchestrator/xstate",
  "version": "0.31.0",
  "description": "XState v5 machines as durable derived control state for Smithers workflows: pure folds over output and signal rows",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "rm -f src/index.d.ts && tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smithers-orchestrator/errors": "workspace:*",
    "@smithers-orchestrator/react-reconciler": "workspace:*",
    "react": "^19.2.7"
  },
  "peerDependencies": {
    "xstate": "^5.19.0"
  },
  "peerDependenciesMeta": {
    "xstate": {
      "optional": true
    }
  },
  "devDependencies": {
    "@smithers-orchestrator/db": "workspace:*",
    "@smithers-orchestrator/driver": "workspace:*",
    "@smithers-orchestrator/engine": "workspace:*",
    "@smithers-orchestrator/time-travel": "workspace:*",
    "@types/bun": "latest",
    "drizzle-orm": "^0.45.2",
    "effect": "3.21.4",
    "smithers-orchestrator": "workspace:*",
    "typescript": "~6.0.3",
    "xstate": "5.32.5",
    "zod": "^4.4.3"
  }
}
