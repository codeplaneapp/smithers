{
  "name": "@smithers-orchestrator/gateway",
  "version": "0.28.0",
  "description": "Stable Smithers Gateway RPC contracts, auth scopes, and deployment metadata",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./rpc": {
      "types": "./src/rpc/index.d.ts",
      "import": "./src/rpc/index.js",
      "default": "./src/rpc/index.js"
    },
    "./auth/scopes": {
      "types": "./src/auth/scopes.d.ts",
      "import": "./src/auth/scopes.js",
      "default": "./src/auth/scopes.js"
    },
    "./api": {
      "types": "./src/api/index.d.ts",
      "import": "./src/api/index.js",
      "default": "./src/api/index.js"
    }
  },
  "files": [
    "src/",
    "openapi.yaml"
  ],
  "scripts": {
    "generate:openapi": "bun run scripts/generate-openapi.ts",
    "check:openapi": "bun run scripts/generate-openapi.ts --check",
    "build": "bun run check:openapi && node ../../scripts/clean-dts.mjs src && tsup --dts-only",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@smithers-orchestrator/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  }
}
