{
  "name": "@smithers-orchestrator/ui-core",
  "version": "0.31.0",
  "description": "Isomorphic headless product layer for Smithers UIs: pure domain modules, Platform DI interfaces, and view-model hooks shared by the web app and the terminal UI",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "node ../../node_modules/tsup/dist/cli-default.js --dts-only",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "bun test tests"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "typescript": "~6.0.3"
  }
}
