{
  "name": "@smthrs/time-travel",
  "version": "0.33.1",
  "description": "Smithers snapshots, diffs, forks, replay, timelines, and VCS-tagged run history",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./snapshot": {
      "types": "./src/index.d.ts",
      "import": "./src/snapshot/index.js",
      "default": "./src/snapshot/index.js"
    },
    "./fork": {
      "types": "./src/index.d.ts",
      "import": "./src/fork/index.js",
      "default": "./src/fork/index.js"
    },
    "./timeline": {
      "types": "./src/index.d.ts",
      "import": "./src/timeline/index.js",
      "default": "./src/timeline/index.js"
    },
    "./vcs-version": {
      "types": "./src/index.d.ts",
      "import": "./src/vcs-version/index.js",
      "default": "./src/vcs-version/index.js"
    },
    "./metrics": {
      "types": "./src/index.d.ts",
      "import": "./src/metrics.js",
      "default": "./src/metrics.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "rm -f src/index.d.ts && tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.102",
    "@smthrs/db": "workspace:*",
    "@smthrs/driver": "workspace:*",
    "@smthrs/errors": "workspace:*",
    "@smthrs/graph": "workspace:*",
    "@smthrs/observability": "workspace:*",
    "@smthrs/react-reconciler": "workspace:*",
    "@smthrs/scheduler": "workspace:*",
    "@smthrs/vcs": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.102",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "react": "^19.2.7",
    "typescript": "~6.0.3"
  }
}
