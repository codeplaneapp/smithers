{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "test/**/*"],
  // The workerd smoke is a separate project with its own runtime and its own
  // tsconfig: it imports a `.wasm` module the bundler supplies and targets
  // workerd rather than Node. See `test/workerd/tsconfig.json`.
  "exclude": ["test/workerd/**"]
}
