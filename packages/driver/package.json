{
  "name": "@smithers-orchestrator/driver",
  "version": "0.28.0",
  "description": "Workflow execution driver — runs tasks, acts on EngineDecisions, reports results",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./interop": {
      "types": "./src/index.d.ts",
      "import": "./src/interop.js",
      "default": "./src/interop.js"
    },
    "./RunOptions": {
      "types": "./src/index.d.ts"
    },
    "./RunResult": {
      "types": "./src/index.d.ts"
    },
    "./RunStatus": {
      "types": "./src/index.d.ts"
    },
    "./RunAuthContext": {
      "types": "./src/index.d.ts"
    },
    "./SmithersCtx": {
      "types": "./src/index.d.ts",
      "import": "./src/SmithersCtx.js",
      "default": "./src/SmithersCtx.js"
    },
    "./OutputAccessor": {
      "types": "./src/index.d.ts"
    },
    "./OutputKey": {
      "types": "./src/index.d.ts"
    },
    "./workflow-types": {
      "types": "./src/index.d.ts"
    },
    "./task-runtime": {
      "types": "./src/index.d.ts",
      "import": "./src/task-runtime.js",
      "default": "./src/task-runtime.js"
    },
    "./child-process": {
      "types": "./src/index.d.ts",
      "import": "./src/child-process.js",
      "default": "./src/child-process.js"
    },
    "./WorkflowDriver": {
      "types": "./src/index.d.ts",
      "import": "./src/WorkflowDriver.js",
      "default": "./src/WorkflowDriver.js"
    },
    "./RuntimeAdapter": {
      "types": "./src/RuntimeAdapter.ts"
    },
    "./RuntimeCapabilityError": {
      "types": "./src/index.d.ts",
      "import": "./src/RuntimeCapabilityError.js",
      "default": "./src/RuntimeCapabilityError.js"
    },
    "./browser-runtime": {
      "types": "./src/index.d.ts",
      "import": "./src/browser-runtime.js",
      "default": "./src/browser-runtime.js"
    },
    "./unsupportedCapability": {
      "types": "./src/index.d.ts",
      "import": "./src/unsupportedCapability.js",
      "default": "./src/unsupportedCapability.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -f src/index.d.ts && tsup --dts-only"
  },
  "dependencies": {
    "@smithers-orchestrator/db": "workspace:*",
    "@smithers-orchestrator/errors": "workspace:*",
    "@smithers-orchestrator/graph": "workspace:*",
    "@smithers-orchestrator/observability": "workspace:*",
    "@smithers-orchestrator/scheduler": "workspace:*",
    "effect": "3.21.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  }
}
