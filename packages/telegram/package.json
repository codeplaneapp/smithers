{
  "name": "@smithers-orchestrator/telegram",
  "version": "0.32.0",
  "description": "Serverless-friendly Telegram Bot API helpers for Smithers workflows and examples",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  }
}
