    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smithers-orchestrator/sandbox": "workspace:*"
  },
  "optionalDependencies": {
    "@cloudflare/sandbox": "^0.12.3"
  },
  "devDependencies": {
    "@smithers-orchestrator/db": "workspace:*",
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  }
