{
  "name": "@smithers-orchestrator/cloudflare",
  "version": "0.27.0",
  "description": "Cloudflare Workers, Durable Object SQLite, D1, and Sandbox SDK integration for Smithers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
