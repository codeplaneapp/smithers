{
  "name": "@smithers-orchestrator/gateway-client",
  "version": "0.31.0",
  "description": "Browser-first client SDK for the Smithers Gateway RPC and event stream APIs",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "import": "./src/rpc.ts",
      "default": "./src/rpc.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@smithers-orchestrator/electric-proxy": "workspace:^",
    "@smithers-orchestrator/gateway": "workspace:*",
    "@smithers-orchestrator/protocol": "workspace:*",
    "@smithers-orchestrator/usage": "workspace:*",
    "@tanstack/db": "0.6.13",
    "@tanstack/electric-db-collection": "0.3.11",
    "@tanstack/query-db-collection": "1.0.45",
    "@tanstack/react-query": "5.101.2"
  },
  "devDependencies": {
    "@smithers-orchestrator/db": "workspace:*",
    "@types/bun": "latest",
    "smithers-orchestrator": "workspace:*",
    "typescript": "~6.0.3"
  }
}
