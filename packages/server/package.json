{
  "name": "@smthrs/server",
  "version": "0.33.1",
  "description": "HTTP, WebSocket, gateway, cron, webhook, and metrics servers for Smithers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -f src/index.d.ts && node ../../node_modules/tsup/dist/cli-default.js --dts-only"
  },
  "dependencies": {
    "@smthrs/accounts": "workspace:*",
    "@smthrs/components": "workspace:*",
    "@smthrs/db": "workspace:*",
    "@smthrs/devtools": "workspace:*",
    "@smthrs/driver": "workspace:*",
    "@smthrs/engine": "workspace:*",
    "@smthrs/errors": "workspace:*",
    "@smthrs/gateway": "workspace:*",
    "@smthrs/graph": "workspace:*",
    "@smthrs/integrations": "workspace:*",
    "@smthrs/observability": "workspace:*",
    "@smthrs/protocol": "workspace:*",
    "@smthrs/scheduler": "workspace:*",
    "@smthrs/ui-styleguide": "workspace:*",
    "@smthrs/time-travel": "workspace:*",
    "@smthrs/usage": "workspace:*",
    "cron-parser": "^5.6.1",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.103",
    "hono": "^4.12.27",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "playwright": "^1.61.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/bun": "latest",
    "playwright": "^1.61.1",
    "typescript": "~6.0.3",
    "zod": "^4.4.3"
  }
}
