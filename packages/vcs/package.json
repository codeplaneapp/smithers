{
  "name": "@smthrs/vcs",
  "version": "0.34.0",
  "description": "VCS discovery and jj workspace operations for Smithers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "rm -f src/index.d.ts && tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.0-beta.105",
    "@smthrs/observability": "workspace:*",
    "effect": "4.0.0-beta.105"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-beta.105",
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "@smthrs/jj-darwin-arm64": "workspace:*",
    "@smthrs/jj-darwin-x64": "workspace:*",
    "@smthrs/jj-linux-arm64": "workspace:*",
    "@smthrs/jj-linux-x64": "workspace:*",
    "@smthrs/jj-win32-x64": "workspace:*"
  }
}
