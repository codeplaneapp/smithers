{
  "name": "@smthrs/pi-plugin",
  "version": "0.32.0",
  "description": "PI coding agent integration for Smithers workflow inspection",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./extension": {
      "types": "./src/extension.ts",
      "import": "./src/extension.ts",
      "default": "./src/extension.ts"
    },
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "import": "./src/runtime/*.ts",
      "default": "./src/runtime/*.ts"
    },
    "./views/*": {
      "types": "./src/views/*.ts",
      "import": "./src/views/*.ts",
      "default": "./src/views/*.ts"
    },
    "./api/*": {
      "types": "./src/api/*.ts",
      "import": "./src/api/*.ts",
      "default": "./src/api/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src/"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sinclair/typebox": "^0.34.49",
    "@smthrs/agents": "workspace:*",
    "@smthrs/cli": "workspace:*",
    "@smthrs/devtools": "workspace:*",
    "@smthrs/errors": "workspace:*",
    "@smthrs/protocol": "workspace:*",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "typescript": "~6.0.3"
  }
}
