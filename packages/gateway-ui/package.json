{
  "name": "@smithers-orchestrator/gateway-ui",
  "version": "0.29.0",
  "description": "Reusable React components for Smithers Gateway UIs — drop-in run lists, approval panels, node trees, event logs and launch controls built on @smithers-orchestrator/gateway-react hooks. Use these to build a custom workflow UI under .smithers/ui/<workflow>.tsx.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styleguide-css": {
      "types": "./src/styleguide-css.ts",
      "import": "./src/styleguide-css.ts",
      "default": "./src/styleguide-css.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "node ../../node_modules/tsup/dist/cli-default.js --dts-only",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@smithers-orchestrator/gateway-client": "workspace:*",
    "@smithers-orchestrator/gateway-react": "workspace:*",
    "@smithers-orchestrator/ui": "workspace:*",
    "@smithers-orchestrator/ui-styleguide": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.3"
  }
}
