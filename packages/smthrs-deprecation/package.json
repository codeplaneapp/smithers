{
  "name": "smthrs",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Migration notice for Smithers 1.0. The runtime ships as @smthrs/* packages; importing this package throws.",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smthrs-deprecation"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "deprecated",
    "migration",
    "smithers"
  ],
  "keywords": [
    "deprecated",
    "migration",
    "smithers"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "rc",
    "exports": {
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.55.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.1.0",
    "eslint-plugin-unicorn": "61.0.2",
    "madge": "8.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.9"
  }
}
