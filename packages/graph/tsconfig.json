{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // Required by the `tsup --dts-only` build: tsup injects a `baseUrl` into the
    // dts compiler options, which TypeScript 6.0.3 flags as deprecated (TS5101).
    // This silences that tooling-injected deprecation; the project itself sets no
    // baseUrl. Remove once tsup stops injecting it.
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "types": [
      "bun-types"
    ],
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "rootDir": "src"
  },
  "include": [
    "src/**/*"
  ]
}
