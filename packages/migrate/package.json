{
  "name": "@smthrs/migrate",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Upgrades Smithers 0.x projects to Smithers 1.0 flows and writes an auditable migration report",
  "homepage": "https://github.com/smithersai/flows",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/flows.git",
    "directory": "packages/migrate"
  },
  "bugs": {
    "url": "https://github.com/smithersai/flows/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "migration"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "migration"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [
    "./src/flow/bin.ts",
    "./dist/esm/flow/bin.js",
    "./dist/cjs/flow/bin.js"
  ],
  "bin": {
    "smithers-migrate": "./dist/esm/flow/bin.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./flow/internal/*": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./*": {
        "types": "./dist/esm/*.d.ts",
        "import": "./dist/esm/*.js",
        "require": "./dist/cjs/*.js"
      },
      "./internal/*": null,
      "./flow/internal/*": null,
      "./*/index": null
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "@effect/platform-node-shared": "4.0.0-rc.108",
    "effect": "4.0.0-rc.108",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@smthrs/agent": "1.0.0-rc.0",
    "@smthrs/core": "1.0.0-rc.0",
    "@smthrs/engine": "1.0.0-rc.0",
    "@smthrs/flow": "1.0.0-rc.0",
    "@smthrs/flows": "1.0.0-rc.0",
    "@smthrs/harness": "1.0.0-rc.0",
    "@smthrs/kernel": "1.0.0-rc.0",
    "@smthrs/model": "1.0.0-rc.0",
    "@smthrs/patterns": "1.0.0-rc.0",
    "@smthrs/plan": "1.0.0-rc.0",
    "@smthrs/platform-node": "1.0.0-rc.0",
    "@smthrs/registry": "1.0.0-rc.0",
    "@smthrs/std": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@effect/vitest": "4.0.0-rc.108",
    "@eslint/js": "9.39.1",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.55.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.1.0",
    "eslint-plugin-unicorn": "61.0.2",
    "madge": "8.0.0",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.9"
  }
}
