{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "smthrs",
    "types": ["bun"]
  },
  "include": ["**/*.ts", "**/*.jsx", "**/*.tsx", "**/*.js"]
}
