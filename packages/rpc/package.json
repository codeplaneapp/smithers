{
  "name": "@smthrs/rpc",
  "version": "0.0.0",
  "private": true,
  "smthrs": {
    "group": "tooling"
  },
  "type": "module",
  "description": "Contract modules shared by the Smithers native app (apps/ui) and the Cloudflare Worker (apps/server): runtime-free zod schemas, route constants, and RPC types",
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0 && dprint check"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@smthrs/canonical": "1.0.0-rc.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "dprint": "0.55.2",
    "eslint": "9.39.1",
    "typescript-eslint": "8.65.0",
    "@types/node": "25.9.5",
    "vitest": "4.1.9"
  }
}
