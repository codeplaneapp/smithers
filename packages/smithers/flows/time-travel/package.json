{
  "name": "@smthrs/time-travel",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "Durable replay, fork, and rewind primitives for flows",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/time-travel"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "time-travel"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "time-travel"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./CompensationHandlers": "./src/CompensationHandlers.ts",
    "./EffectBoundary": "./src/EffectBoundary.ts",
    "./Frame": "./src/Frame.ts",
    "./MemoryTimeTravelStore": "./src/MemoryTimeTravelStore.ts",
    "./Migrations": "./src/Migrations.ts",
    "./SqlTimeTravelStore": "./src/SqlTimeTravelStore.ts",
    "./TimeTravel": "./src/TimeTravel.ts",
    "./TimeTravelError": "./src/TimeTravelError.ts",
    "./TimeTravelStore": "./src/TimeTravelStore.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./CompensationHandlers": {
        "types": "./dist/esm/CompensationHandlers.d.ts",
        "import": "./dist/esm/CompensationHandlers.js",
        "require": "./dist/cjs/CompensationHandlers.js"
      },
      "./EffectBoundary": {
        "types": "./dist/esm/EffectBoundary.d.ts",
        "import": "./dist/esm/EffectBoundary.js",
        "require": "./dist/cjs/EffectBoundary.js"
      },
      "./Frame": {
        "types": "./dist/esm/Frame.d.ts",
        "import": "./dist/esm/Frame.js",
        "require": "./dist/cjs/Frame.js"
      },
      "./MemoryTimeTravelStore": {
        "types": "./dist/esm/MemoryTimeTravelStore.d.ts",
        "import": "./dist/esm/MemoryTimeTravelStore.js",
        "require": "./dist/cjs/MemoryTimeTravelStore.js"
      },
      "./Migrations": {
        "types": "./dist/esm/Migrations.d.ts",
        "import": "./dist/esm/Migrations.js",
        "require": "./dist/cjs/Migrations.js"
      },
      "./SqlTimeTravelStore": {
        "types": "./dist/esm/SqlTimeTravelStore.d.ts",
        "import": "./dist/esm/SqlTimeTravelStore.js",
        "require": "./dist/cjs/SqlTimeTravelStore.js"
      },
      "./TimeTravel": {
        "types": "./dist/esm/TimeTravel.d.ts",
        "import": "./dist/esm/TimeTravel.js",
        "require": "./dist/cjs/TimeTravel.js"
      },
      "./TimeTravelError": {
        "types": "./dist/esm/TimeTravelError.d.ts",
        "import": "./dist/esm/TimeTravelError.js",
        "require": "./dist/cjs/TimeTravelError.js"
      },
      "./TimeTravelStore": {
        "types": "./dist/esm/TimeTravelStore.d.ts",
        "import": "./dist/esm/TimeTravelStore.js",
        "require": "./dist/cjs/TimeTravelStore.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src test --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/database": "1.0.0-rc.0",
    "@smthrs/engine-store": "1.0.0-rc.0",
    "@smthrs/jj": "1.0.0-rc.0",
    "@smthrs/journal": "1.0.0-rc.0",
    "@smthrs/run-store": "1.0.0-rc.0",
    "@smthrs/step-cache": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@smthrs/artifacts": "1.0.0-rc.0",
    "@smthrs/engine": "1.0.0-rc.0",
    "@smthrs/flow": "1.0.0-rc.0",
    "@smthrs/kernel": "1.0.0-rc.0",
    "@smthrs/plan": "1.0.0-rc.0",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
