{
  "name": "@smthrs/journal",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "Effect services for the Smithers event journal: the immutable run history and the owner fence on its durable channel",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/journal"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "journal",
    "durability"
  ],
  "keywords": [
    "typescript",
    "effect",
    "journal",
    "durability"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./migrations/*": null,
    "./*/index": null,
    "./Journal": "./src/Journal.ts",
    "./JournalEvent": "./src/JournalEvent.ts",
    "./EngineEvent": "./src/EngineEvent.ts",
    "./JournalMetrics": "./src/JournalMetrics.ts",
    "./Migrations": "./src/Migrations.ts",
    "./OwnerId": "./src/OwnerId.ts",
    "./Projection": "./src/Projection.ts",
    "./RedactedLogger": "./src/RedactedLogger.ts",
    "./Redaction": "./src/Redaction.ts",
    "./SqlJournal": "./src/SqlJournal.ts",
    "./index": "./src/index.ts",
    "./test/Notifying": "./src/test/Notifying.ts",
    "./test/TestJournal": "./src/test/TestJournal.ts",
    "./JournalGeneration": "./src/JournalGeneration.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./internal/*": null,
      "./migrations/*": null,
      "./*/index": null,
      "./Journal": {
        "types": "./dist/esm/Journal.d.ts",
        "import": "./dist/esm/Journal.js",
        "require": "./dist/cjs/Journal.js"
      },
      "./JournalEvent": {
        "types": "./dist/esm/JournalEvent.d.ts",
        "import": "./dist/esm/JournalEvent.js",
        "require": "./dist/cjs/JournalEvent.js"
      },
      "./EngineEvent": {
        "types": "./dist/esm/EngineEvent.d.ts",
        "import": "./dist/esm/EngineEvent.js",
        "require": "./dist/cjs/EngineEvent.js"
      },
      "./JournalMetrics": {
        "types": "./dist/esm/JournalMetrics.d.ts",
        "import": "./dist/esm/JournalMetrics.js",
        "require": "./dist/cjs/JournalMetrics.js"
      },
      "./Migrations": {
        "types": "./dist/esm/Migrations.d.ts",
        "import": "./dist/esm/Migrations.js",
        "require": "./dist/cjs/Migrations.js"
      },
      "./OwnerId": {
        "types": "./dist/esm/OwnerId.d.ts",
        "import": "./dist/esm/OwnerId.js",
        "require": "./dist/cjs/OwnerId.js"
      },
      "./Projection": {
        "types": "./dist/esm/Projection.d.ts",
        "import": "./dist/esm/Projection.js",
        "require": "./dist/cjs/Projection.js"
      },
      "./RedactedLogger": {
        "types": "./dist/esm/RedactedLogger.d.ts",
        "import": "./dist/esm/RedactedLogger.js",
        "require": "./dist/cjs/RedactedLogger.js"
      },
      "./Redaction": {
        "types": "./dist/esm/Redaction.d.ts",
        "import": "./dist/esm/Redaction.js",
        "require": "./dist/cjs/Redaction.js"
      },
      "./SqlJournal": {
        "types": "./dist/esm/SqlJournal.d.ts",
        "import": "./dist/esm/SqlJournal.js",
        "require": "./dist/cjs/SqlJournal.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./test/Notifying": {
        "types": "./dist/esm/test/Notifying.d.ts",
        "import": "./dist/esm/test/Notifying.js",
        "require": "./dist/cjs/test/Notifying.js"
      },
      "./test/TestJournal": {
        "types": "./dist/esm/test/TestJournal.d.ts",
        "import": "./dist/esm/test/TestJournal.js",
        "require": "./dist/cjs/test/TestJournal.js"
      },
      "./JournalGeneration": {
        "types": "./dist/esm/JournalGeneration.d.ts",
        "import": "./dist/esm/JournalGeneration.js",
        "require": "./dist/cjs/JournalGeneration.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/database": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/sql-sqlite-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@smthrs/flow": "1.0.0-rc.0",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
