{
  "name": "@smthrs/canonical",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "RFC 8785 canonical JSON as an Effect Schema",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/canonical"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./Canonical": "./src/Canonical.ts",
    "./index": "./src/index.ts",
    "./Record": "./src/Record.ts",
    "./BoundedJson": "./src/BoundedJson.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./Canonical": {
        "types": "./dist/esm/Canonical.d.ts",
        "import": "./dist/esm/Canonical.js",
        "require": "./dist/cjs/Canonical.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./Record": {
        "types": "./dist/esm/Record.d.ts",
        "import": "./dist/esm/Record.js",
        "require": "./dist/cjs/Record.js"
      },
      "./BoundedJson": {
        "types": "./dist/esm/BoundedJson.d.ts",
        "import": "./dist/esm/BoundedJson.js",
        "require": "./dist/cjs/BoundedJson.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "pretest": "pnpm run test:dist",
    "test": "vitest",
    "test:dist": "pnpm run build && node --test test/dist-smoke.mjs",
    "coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
