{
  "name": "@smthrs/jj",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "Jujutsu version control as a portable Effect host service",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/jj"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "jj",
    "jujutsu",
    "vcs"
  ],
  "keywords": [
    "typescript",
    "effect",
    "jj",
    "jujutsu",
    "vcs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./wasm/flows_jj.wasm": "./wasm/flows_jj.wasm",
    "./internal/*": null,
    "./*/index": null,
    "./Jj": "./src/Jj.ts",
    "./browser/BrowserJj": "./src/browser/BrowserJj.ts",
    "./browser/WasiFs": "./src/browser/WasiFs.ts",
    "./browser/WasiPreview1": "./src/browser/WasiPreview1.ts",
    "./bun/BunJj": "./src/bun/BunJj.ts",
    "./index": "./src/index.ts",
    "./node/NodeJj": "./src/node/NodeJj.ts",
    "./node/resolveJjBinary": "./src/node/resolveJjBinary.ts"
  },
  "files": [
    "src/**/*.ts",
    "wasm/*.wasm",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./wasm/flows_jj.wasm": "./wasm/flows_jj.wasm",
      "./internal/*": null,
      "./*/index": null,
      "./Jj": {
        "types": "./dist/esm/Jj.d.ts",
        "import": "./dist/esm/Jj.js",
        "require": "./dist/cjs/Jj.js"
      },
      "./browser/BrowserJj": {
        "types": "./dist/esm/browser/BrowserJj.d.ts",
        "import": "./dist/esm/browser/BrowserJj.js",
        "require": "./dist/cjs/browser/BrowserJj.js"
      },
      "./browser/WasiFs": {
        "types": "./dist/esm/browser/WasiFs.d.ts",
        "import": "./dist/esm/browser/WasiFs.js",
        "require": "./dist/cjs/browser/WasiFs.js"
      },
      "./browser/WasiPreview1": {
        "types": "./dist/esm/browser/WasiPreview1.d.ts",
        "import": "./dist/esm/browser/WasiPreview1.js",
        "require": "./dist/cjs/browser/WasiPreview1.js"
      },
      "./bun/BunJj": {
        "types": "./dist/esm/bun/BunJj.d.ts",
        "import": "./dist/esm/bun/BunJj.js",
        "require": "./dist/cjs/bun/BunJj.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./node/NodeJj": {
        "types": "./dist/esm/node/NodeJj.d.ts",
        "import": "./dist/esm/node/NodeJj.js",
        "require": "./dist/cjs/node/NodeJj.js"
      },
      "./node/resolveJjBinary": {
        "types": "./dist/esm/node/resolveJjBinary.d.ts",
        "import": "./dist/esm/node/resolveJjBinary.js",
        "require": "./dist/cjs/node/resolveJjBinary.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "build:wasm": "node ../../../../crates/flows-jj/build-wasm.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/capability": "1.0.0-rc.0",
    "@smthrs/canonical": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
