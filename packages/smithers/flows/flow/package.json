{
  "name": "@smthrs/flow",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "The flow authoring model: flows, actions, durable waits, retry policy, and the runtime port they execute against",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/flow"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "durability"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "durability"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./Action": "./src/Action/index.ts",
    "./Action/*": null,
    "./CacheEnvironment": "./src/Action/CacheEnvironment.ts",
    "./FileBoundary": "./src/Action/FileBoundary.ts",
    "./FileInput": "./src/Action/FileInput.ts",
    "./Flow": "./src/Flow/index.ts",
    "./Flow/*": null,
    "./FlowRuntime": "./src/FlowRuntime/index.ts",
    "./FlowRuntime/*": null,
    "./StepIdentity": "./src/Action/StepIdentity.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./Action": {
        "types": "./dist/esm/Action/index.d.ts",
        "import": "./dist/esm/Action/index.js",
        "require": "./dist/cjs/Action/index.js"
      },
      "./Action/*": null,
      "./CacheEnvironment": {
        "types": "./dist/esm/Action/CacheEnvironment.d.ts",
        "import": "./dist/esm/Action/CacheEnvironment.js",
        "require": "./dist/cjs/Action/CacheEnvironment.js"
      },
      "./FileBoundary": {
        "types": "./dist/esm/Action/FileBoundary.d.ts",
        "import": "./dist/esm/Action/FileBoundary.js",
        "require": "./dist/cjs/Action/FileBoundary.js"
      },
      "./FileInput": {
        "types": "./dist/esm/Action/FileInput.d.ts",
        "import": "./dist/esm/Action/FileInput.js",
        "require": "./dist/cjs/Action/FileInput.js"
      },
      "./Flow": {
        "types": "./dist/esm/Flow/index.d.ts",
        "import": "./dist/esm/Flow/index.js",
        "require": "./dist/cjs/Flow/index.js"
      },
      "./Flow/*": null,
      "./FlowRuntime": {
        "types": "./dist/esm/FlowRuntime/index.d.ts",
        "import": "./dist/esm/FlowRuntime/index.js",
        "require": "./dist/cjs/FlowRuntime/index.js"
      },
      "./FlowRuntime/*": null,
      "./StepIdentity": {
        "types": "./dist/esm/Action/StepIdentity.d.ts",
        "import": "./dist/esm/Action/StepIdentity.js",
        "require": "./dist/cjs/Action/StepIdentity.js"
      },
      "./*": {
        "types": "./dist/esm/*.d.ts",
        "import": "./dist/esm/*.js",
        "require": "./dist/cjs/*.js"
      },
      "./internal/*": null,
      "./*/index": null
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/crypto": "1.0.0-rc.0",
    "@smthrs/keys": "1.0.0-rc.0",
    "@smthrs/plan": "1.0.0-rc.0",
    "@smthrs/canonical": "1.0.0-rc.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.108"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@effect/platform-node": "4.0.0-rc.108",
    "@effect/vitest": "4.0.0-rc.108",
    "@eslint/js": "9.39.1",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.55.2",
    "effect": "4.0.0-rc.108",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.1.0",
    "eslint-plugin-unicorn": "61.0.2",
    "madge": "8.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.9"
  }
}
