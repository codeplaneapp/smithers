{
  "name": "@smthrs/database",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "A driver-neutral SQL contract with a bounded write-retry seam, plus the composed migration ladder",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/database"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "sql",
    "sqlite"
  ],
  "keywords": [
    "typescript",
    "effect",
    "sql",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./DatabaseMetrics": "./src/DatabaseMetrics.ts",
    "./DurableWriter": "./src/DurableWriter.ts",
    "./Migrations": "./src/Migrations.ts",
    "./UnsupportedBackend": "./src/UnsupportedBackend.ts",
    "./index": "./src/index.ts",
    "./node/NodeDatabase": "./src/node/NodeDatabase.ts",
    "./test/TestDatabase": "./src/test/TestDatabase.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./DatabaseMetrics": {
        "types": "./dist/esm/DatabaseMetrics.d.ts",
        "import": "./dist/esm/DatabaseMetrics.js",
        "require": "./dist/cjs/DatabaseMetrics.js"
      },
      "./DurableWriter": {
        "types": "./dist/esm/DurableWriter.d.ts",
        "import": "./dist/esm/DurableWriter.js",
        "require": "./dist/cjs/DurableWriter.js"
      },
      "./Migrations": {
        "types": "./dist/esm/Migrations.d.ts",
        "import": "./dist/esm/Migrations.js",
        "require": "./dist/cjs/Migrations.js"
      },
      "./UnsupportedBackend": {
        "types": "./dist/esm/UnsupportedBackend.d.ts",
        "import": "./dist/esm/UnsupportedBackend.js",
        "require": "./dist/cjs/UnsupportedBackend.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./node/NodeDatabase": {
        "types": "./dist/esm/node/NodeDatabase.d.ts",
        "import": "./dist/esm/node/NodeDatabase.js",
        "require": "./dist/cjs/node/NodeDatabase.js"
      },
      "./test/TestDatabase": {
        "types": "./dist/esm/test/TestDatabase.d.ts",
        "import": "./dist/esm/test/TestDatabase.js",
        "require": "./dist/cjs/test/TestDatabase.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/sql-sqlite-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "@effect/sql-sqlite-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "peerDependenciesMeta": {
    "@effect/sql-sqlite-node": {
      "optional": true
    }
  }
}
