{
  "name": "@smthrs/platform-node",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "Node.js Host bundle for flows: Effect's Node platform services composed into the closed Host surface",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/platform-node"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "node",
    "platform"
  ],
  "keywords": [
    "typescript",
    "effect",
    "node",
    "platform"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./AtomicFileSystem": "./src/AtomicFileSystem.ts",
    "./HostLiveness": "./src/HostLiveness.ts",
    "./NodeHost": "./src/NodeHost.ts",
    "./ProcessReaper": "./src/ProcessReaper.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./AtomicFileSystem": {
        "types": "./dist/esm/AtomicFileSystem.d.ts",
        "import": "./dist/esm/AtomicFileSystem.js",
        "require": "./dist/cjs/AtomicFileSystem.js"
      },
      "./HostLiveness": {
        "types": "./dist/esm/HostLiveness.d.ts",
        "import": "./dist/esm/HostLiveness.js",
        "require": "./dist/cjs/HostLiveness.js"
      },
      "./NodeHost": {
        "types": "./dist/esm/NodeHost.d.ts",
        "import": "./dist/esm/NodeHost.js",
        "require": "./dist/cjs/NodeHost.js"
      },
      "./ProcessReaper": {
        "types": "./dist/esm/ProcessReaper.d.ts",
        "import": "./dist/esm/ProcessReaper.js",
        "require": "./dist/cjs/ProcessReaper.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/jj": "1.0.0-rc.0",
    "@smthrs/kernel": "1.0.0-rc.0"
  },
  "peerDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@smthrs/journal": "1.0.0-rc.0",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  }
}
