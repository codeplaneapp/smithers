    "background-agents",
    "orchestration",
    "workflow",
    "durable-execution",
    "human-in-the-loop",
    "multi-agent",
    "time-travel",
    "react",
    "jsx",
    "llm",
    "claude",
    "claude-code",
    "codex",
    "gemini",
    "bun"
  ],
  "type": "module",
  "sideEffects": false,
