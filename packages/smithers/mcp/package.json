{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@smthrs/mcp",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Model Context Protocol client and flow adapter: projects a remote MCP server's tools as ordinary FlowBinding.Source entries",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/mcp"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "mcp",
    "flow-registry"
  ],
  "keywords": [
    "typescript",
    "effect",
    "mcp",
    "flow-registry"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./Diagnostics": "./src/Diagnostics.ts",
    "./McpClient": "./src/McpClient.ts",
    "./McpError": "./src/McpError.ts",
    "./McpFlows": "./src/McpFlows.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./Diagnostics": {
        "types": "./dist/esm/Diagnostics.d.ts",
        "import": "./dist/esm/Diagnostics.js",
        "require": "./dist/cjs/Diagnostics.js"
      },
      "./McpClient": {
        "types": "./dist/esm/McpClient.d.ts",
        "import": "./dist/esm/McpClient.js",
        "require": "./dist/cjs/McpClient.js"
      },
      "./McpError": {
        "types": "./dist/esm/McpError.d.ts",
        "import": "./dist/esm/McpError.js",
        "require": "./dist/cjs/McpError.js"
      },
      "./McpFlows": {
        "types": "./dist/esm/McpFlows.d.ts",
        "import": "./dist/esm/McpFlows.js",
        "require": "./dist/cjs/McpFlows.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/canonical": "1.0.0-rc.0",
    "@smthrs/capability": "1.0.0-rc.0",
    "@smthrs/core": "1.0.0-rc.0",
    "@smthrs/harness": "1.0.0-rc.0",
    "@smthrs/journal": "1.0.0-rc.0",
    "@smthrs/kernel": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@smthrs/model": "1.0.0-rc.0",
    "@smthrs/registry": "1.0.0-rc.0",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
