{
  "name": "@smthrs/build-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare deployment of the hosted smithers build remote cache",
  "license": "MIT",
  "smthrs": {
    "group": "tooling"
  },
  "type": "module",
  "sideEffects": [],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc -b tsconfig.json --force",
    "deploy": "node scripts/deploy.ts --stage prod",
    "deploy:dev": "node scripts/deploy.ts",
    "test": "vitest run",
    "lint": "eslint worker scripts deployment.ts alchemy.run.ts --max-warnings=0 && dprint check"
  },
  "dependencies": {
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.108",
    "@smthrs/canonical": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260814.1",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "eslint": "9.39.1",
    "typescript-eslint": "8.65.0",
    "dprint": "0.55.2"
  }
}
