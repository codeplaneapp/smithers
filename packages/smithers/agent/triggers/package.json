{
  "name": "@smthrs/triggers",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Durable cron triggers and channel contracts for flows",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/agent/triggers"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "triggers"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "triggers"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./migrations/*": null,
    "./internal/*": null,
    "./*/index": null,
    "./CatchUp": "./src/CatchUp.ts",
    "./Channel": "./src/Channel.ts",
    "./Cron": "./src/Cron.ts",
    "./DispatchReader": "./src/DispatchReader.ts",
    "./Overlap": "./src/Overlap.ts",
    "./Schedule": "./src/Schedule.ts",
    "./Scheduler": "./src/Scheduler.ts",
    "./SqlTriggerStore": "./src/SqlTriggerStore.ts",
    "./Trigger": "./src/Trigger.ts",
    "./TriggerError": "./src/TriggerError.ts",
    "./TriggerStore": "./src/TriggerStore.ts",
    "./Webhook": "./src/Webhook.ts",
    "./index": "./src/index.ts",
    "./test/TestTriggers": "./src/test/TestTriggers.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./migrations/*": null,
      "./internal/*": null,
      "./*/index": null,
      "./CatchUp": {
        "types": "./dist/esm/CatchUp.d.ts",
        "import": "./dist/esm/CatchUp.js",
        "require": "./dist/cjs/CatchUp.js"
      },
      "./Channel": {
        "types": "./dist/esm/Channel.d.ts",
        "import": "./dist/esm/Channel.js",
        "require": "./dist/cjs/Channel.js"
      },
      "./Cron": {
        "types": "./dist/esm/Cron.d.ts",
        "import": "./dist/esm/Cron.js",
        "require": "./dist/cjs/Cron.js"
      },
      "./DispatchReader": {
        "types": "./dist/esm/DispatchReader.d.ts",
        "import": "./dist/esm/DispatchReader.js",
        "require": "./dist/cjs/DispatchReader.js"
      },
      "./Overlap": {
        "types": "./dist/esm/Overlap.d.ts",
        "import": "./dist/esm/Overlap.js",
        "require": "./dist/cjs/Overlap.js"
      },
      "./Schedule": {
        "types": "./dist/esm/Schedule.d.ts",
        "import": "./dist/esm/Schedule.js",
        "require": "./dist/cjs/Schedule.js"
      },
      "./Scheduler": {
        "types": "./dist/esm/Scheduler.d.ts",
        "import": "./dist/esm/Scheduler.js",
        "require": "./dist/cjs/Scheduler.js"
      },
      "./SqlTriggerStore": {
        "types": "./dist/esm/SqlTriggerStore.d.ts",
        "import": "./dist/esm/SqlTriggerStore.js",
        "require": "./dist/cjs/SqlTriggerStore.js"
      },
      "./Trigger": {
        "types": "./dist/esm/Trigger.d.ts",
        "import": "./dist/esm/Trigger.js",
        "require": "./dist/cjs/Trigger.js"
      },
      "./TriggerError": {
        "types": "./dist/esm/TriggerError.d.ts",
        "import": "./dist/esm/TriggerError.js",
        "require": "./dist/cjs/TriggerError.js"
      },
      "./TriggerStore": {
        "types": "./dist/esm/TriggerStore.d.ts",
        "import": "./dist/esm/TriggerStore.js",
        "require": "./dist/cjs/TriggerStore.js"
      },
      "./Webhook": {
        "types": "./dist/esm/Webhook.d.ts",
        "import": "./dist/esm/Webhook.js",
        "require": "./dist/cjs/Webhook.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./test/TestTriggers": {
        "types": "./dist/esm/test/TestTriggers.d.ts",
        "import": "./dist/esm/test/TestTriggers.js",
        "require": "./dist/cjs/test/TestTriggers.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/control": "1.0.0-rc.0",
    "@smthrs/database": "1.0.0-rc.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  }
}
