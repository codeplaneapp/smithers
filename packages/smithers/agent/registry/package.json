{
  "name": "@smthrs/registry",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Portable flow descriptor discovery and progressive-disclosure registry services",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/agent/registry"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "registry"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "registry"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./Descriptor": "./src/Descriptor.ts",
    "./Disclosure": "./src/Disclosure.ts",
    "./Discovery": "./src/Discovery.ts",
    "./Executable": "./src/Executable.ts",
    "./MarkdownFlow": "./src/MarkdownFlow.ts",
    "./Pack": "./src/Pack.ts",
    "./Registry": "./src/Registry.ts",
    "./RegistryError": "./src/RegistryError.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./Descriptor": {
        "types": "./dist/esm/Descriptor.d.ts",
        "import": "./dist/esm/Descriptor.js",
        "require": "./dist/cjs/Descriptor.js"
      },
      "./Disclosure": {
        "types": "./dist/esm/Disclosure.d.ts",
        "import": "./dist/esm/Disclosure.js",
        "require": "./dist/cjs/Disclosure.js"
      },
      "./Discovery": {
        "types": "./dist/esm/Discovery.d.ts",
        "import": "./dist/esm/Discovery.js",
        "require": "./dist/cjs/Discovery.js"
      },
      "./Executable": {
        "types": "./dist/esm/Executable.d.ts",
        "import": "./dist/esm/Executable.js",
        "require": "./dist/cjs/Executable.js"
      },
      "./MarkdownFlow": {
        "types": "./dist/esm/MarkdownFlow.d.ts",
        "import": "./dist/esm/MarkdownFlow.js",
        "require": "./dist/cjs/MarkdownFlow.js"
      },
      "./Pack": {
        "types": "./dist/esm/Pack.d.ts",
        "import": "./dist/esm/Pack.js",
        "require": "./dist/cjs/Pack.js"
      },
      "./Registry": {
        "types": "./dist/esm/Registry.d.ts",
        "import": "./dist/esm/Registry.js",
        "require": "./dist/cjs/Registry.js"
      },
      "./RegistryError": {
        "types": "./dist/esm/RegistryError.d.ts",
        "import": "./dist/esm/RegistryError.js",
        "require": "./dist/cjs/RegistryError.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/core": "1.0.0-rc.0",
    "@smthrs/flow": "1.0.0-rc.0",
    "@smthrs/plan": "1.0.0-rc.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@smthrs/artifacts": "1.0.0-rc.0",
    "@smthrs/engine-store": "1.0.0-rc.0",
    "@smthrs/journal": "1.0.0-rc.0",
    "@smthrs/kernel": "1.0.0-rc.0",
    "@smthrs/run-store": "1.0.0-rc.0",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
