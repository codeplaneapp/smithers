{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    // The worker runs in workerd, not in Node, and `WebAssembly` and `Response`
