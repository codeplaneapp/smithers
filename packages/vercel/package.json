{
  "name": "@smithers-orchestrator/vercel",
  "version": "0.29.0",
  "description": "Vercel Sandbox provider for Smithers: run durable workflow sandboxes on Vercel Sandbox compute",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smithers-orchestrator/errors": "workspace:*",
    "@smithers-orchestrator/sandbox": "workspace:*"
  },
  "optionalDependencies": {
    "@vercel/sandbox": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  }
}
