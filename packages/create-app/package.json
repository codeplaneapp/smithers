{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@smthrs/create-app",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "smthrs": {
    "group": "tooling"
  },
  "description": "Declare a Smithers app in one PACKAGE.ts: file-routed flows, panes, and Cloudflare targets",
  "homepage": "https://github.com/smithersai/flows",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/flows.git",
    "directory": "packages/create-app"
  },
  "bugs": {
    "url": "https://github.com/smithersai/flows/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "scaffolding",
    "router"
  ],
  "keywords": [
    "typescript",
    "effect",
    "scaffolding",
    "router"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "bin": {
    "smthrs-routes": "./bin/routes.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./package": "./src/package.ts",
    "./ui": "./src/ui.ts",
    "./runtime": "./src/runtime.ts",
    "./router": "./src/router.ts",
    "./vite": "./src/vite.ts",
    "./testing": "./src/testing.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "files": [
    "bin/**/*.mjs",
    "src/**/*.ts",
    "template/**",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./app": {
        "types": "./dist/esm/app.d.ts",
        "import": "./dist/esm/app.js",
        "require": "./dist/cjs/app.js"
      },
      "./package": {
        "types": "./dist/esm/package.d.ts",
        "import": "./dist/esm/package.js",
        "require": "./dist/cjs/package.js"
      },
      "./ui": {
        "types": "./dist/esm/ui.d.ts",
        "import": "./dist/esm/ui.js",
        "require": "./dist/cjs/ui.js"
      },
      "./runtime": {
        "types": "./dist/esm/runtime.d.ts",
        "import": "./dist/esm/runtime.js",
        "require": "./dist/cjs/runtime.js"
      },
      "./router": {
        "types": "./dist/esm/router.d.ts",
        "import": "./dist/esm/router.js",
        "require": "./dist/cjs/router.js"
      },
      "./vite": {
        "types": "./dist/esm/vite.d.ts",
        "import": "./dist/esm/vite.js",
        "require": "./dist/cjs/vite.js"
      },
      "./testing": {
        "types": "./dist/esm/testing.d.ts",
        "import": "./dist/esm/testing.js",
        "require": "./dist/cjs/testing.js"
      },
      "./*": {
        "types": "./dist/esm/*.d.ts",
        "import": "./dist/esm/*.js",
        "require": "./dist/cjs/*.js"
      },
      "./internal/*": null,
      "./*/index": null
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "@smthrs/agent": "0.1.0",
    "@smthrs/engine": "0.1.0",
    "@smthrs/flow": "0.1.0",
    "@smthrs/harness": "0.1.0",
    "@smthrs/model": "0.1.0",
    "@smthrs/registry": "0.1.0",
    "@smthrs/targets": "0.1.0",
    "@smthrs/testing": "0.1.0",
    "effect": "4.0.0-rc.108",
    "@smthrs/capability": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "tsx": "^4.20.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "tsx": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@effect/vitest": "4.0.0-rc.108",
    "@eslint/js": "9.39.1",
    "@types/node": "25.9.5",
    "@types/react": "19.2.17",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.55.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.1.0",
    "eslint-plugin-unicorn": "61.0.2",
    "madge": "8.0.0",
    "react": "19.2.7",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.2.1",
    "vitest": "4.1.9"
  }
}
