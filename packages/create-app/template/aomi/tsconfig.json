{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types", "node", "vite/client"]
  },
  "include": [
    "PACKAGE.ts", "AGENT.ts", "SANDBOX.ts", "TOOLS.ts", "routes.gen.ts", "routes.ui.gen.ts", "vite.config.ts",
    ".smithers/**/*.ts", "app/**/*", "flows/**/*", "tools/**/*", "worker/**/*", "src/**/*",
    "test/**/*"
  ]
}
