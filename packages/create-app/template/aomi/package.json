    "@smthrs/create-app": "0.1.0",
    "@smthrs/engine": "0.1.0",
    "@smthrs/flow": "0.1.0",
    "@smthrs/harness": "0.1.0",
    "@smthrs/kernel": "0.1.0",
    "@smthrs/model": "0.1.0",
    "@smthrs/plan": "0.1.0",
    "@smthrs/registry": "0.1.0",
    "@smthrs/std": "0.1.0",
    "@smthrs/targets": "0.1.0",
