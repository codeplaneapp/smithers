{
  "name": "@smthrs/testing",
  "version": "0.33.1",
  "description": "Workflow testing helpers for Smithers",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/*.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/",
    "types/"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dts.mjs src && tsup",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@smthrs/components": "workspace:*",
    "@smthrs/db": "workspace:*",
    "@smthrs/driver": "workspace:*",
    "@smthrs/engine": "workspace:*",
    "@smthrs/graph": "workspace:*",
    "@smthrs/react-reconciler": "workspace:*",
    "@smthrs/scheduler": "workspace:*",
    "effect": "4.0.0-beta.105",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "koffi": "^2.16.2"
  },
  "peerDependenciesMeta": {
    "koffi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "koffi": "^2.16.2",
    "smthrs": "workspace:*",
    "typescript": "~6.0.3"
  }
}
