{
  "name": "@smithers-orchestrator/testing",
  "version": "0.26.1",
  "description": "Workflow testing helpers for Smithers",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@smithers-orchestrator/components": "workspace:*",
    "@smithers-orchestrator/driver": "workspace:*",
    "@smithers-orchestrator/graph": "workspace:*",
    "@smithers-orchestrator/react-reconciler": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "smithers-orchestrator": "workspace:*",
    "typescript": "~6.0.3"
  }
}
