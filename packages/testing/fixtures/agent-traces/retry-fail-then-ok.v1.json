{
  "version": 1,
  "id": "retry-fail-then-ok",
  "engineHint": "any",
  "turns": [
    {
      "when": { "attempt": 1 },
      "stream": [{ "t": "text", "text": "attempt 1 failing\n" }],
      "result": {
        "kind": "fail",
        "error": "transient simulated failure",
        "retryable": true
      }
    },
    {
      "when": { "attempt": 2 },
      "stream": [{ "t": "text", "text": "attempt 2 ok\n" }],
      "result": {
        "kind": "ok",
        "output": { "summary": "recovered on retry", "ok": true }
      }
    }
  ]
}
