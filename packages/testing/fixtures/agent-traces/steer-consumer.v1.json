{
  "version": 1,
  "id": "steer-consumer",
  "engineHint": "any",
  "turns": [
    {
      "when": { "promptIncludes": "FOCUS_EDGE_CASES" },
      "stream": [{ "t": "text", "text": "applying steer…\n" }],
      "result": {
        "kind": "ok",
        "output": { "summary": "followed steer FOCUS_EDGE_CASES", "ok": true, "steerd": true }
      }
    },
    {
      "stream": [{ "t": "text", "text": "no steer path\n" }],
      "result": {
        "kind": "ok",
        "output": { "summary": "default path", "ok": true, "steerd": false }
      }
    }
  ]
}
