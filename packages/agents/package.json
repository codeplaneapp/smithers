{
  "name": "@smthrs/agents",
  "version": "0.35.0",
  "description": "flows model and CLI agent adapters for Smithers",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./BaseCliAgent": {
      "types": "./src/BaseCliAgent/index.d.ts",
      "import": "./src/BaseCliAgent/index.js",
      "default": "./src/BaseCliAgent/index.js"
    },
    "./agent-contract": {
      "types": "./src/index.d.ts",
      "import": "./src/agent-contract/index.js",
      "default": "./src/agent-contract/index.js"
    },
    "./diagnostics": {
      "types": "./src/index.d.ts",
      "import": "./src/diagnostics/index.js",
      "default": "./src/diagnostics/index.js"
    },
    "./capability-registry": {
      "types": "./src/index.d.ts",
      "import": "./src/capability-registry/index.js",
      "default": "./src/capability-registry/index.js"
    },
    "./cli-capabilities": {
      "types": "./src/index.d.ts",
      "import": "./src/cli-capabilities/index.js",
      "default": "./src/cli-capabilities/index.js"
    },
    "./mcp/createMcpToolset": {
      "types": "./src/mcp/createMcpToolset.d.ts",
      "import": "./src/mcp/createMcpToolset.js",
      "default": "./src/mcp/createMcpToolset.js"
    },
    "./document-parsing/createDocumentParsingToolset": {
      "types": "./src/document-parsing/createDocumentParsingToolset.d.ts",
      "import": "./src/document-parsing/createDocumentParsingToolset.js",
      "default": "./src/document-parsing/createDocumentParsingToolset.js"
    },
    "./image-generation/createImageGenerationTool": {
      "types": "./src/image-generation/createImageGenerationTool.d.ts",
      "import": "./src/image-generation/createImageGenerationTool.js",
      "default": "./src/image-generation/createImageGenerationTool.js"
    },
    "./nanocodex/checkpoint": null,
    "./nanocodex/process": null,
    "./nanocodex/protocol": null,
    "./nanocodex/protocol-types": null,
    "./nanocodex/checkpoint.js": null,
    "./nanocodex/process.js": null,
    "./nanocodex/protocol.js": null,
    "./nanocodex/protocol-types.js": null,
    "./nanocodex/*": null,
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/",
    "internal/"
  ],
  "scripts": {
    "test": "bun test --timeout=60000 --max-concurrency=1 tests",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:package-export",
    "typecheck:package-export": "tsc -p tests/type-consumer/tsconfig.json --noEmit",
    "build": "rm -f src/index.d.ts src/index-*.d.ts src/BaseCliAgent/index.d.ts && tsup --dts-only"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "@flows/harness": "0.1.0",
    "@flows/model": "0.1.0",
    "@smthrs/accounts": "workspace:*",
    "@smthrs/driver": "workspace:*",
    "@smthrs/errors": "workspace:*",
    "@smthrs/observability": "workspace:*",
    "@smthrs/usage": "workspace:*",
    "effect": "4.0.0-rc.108",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "latest",
    "react": "^19.2.7",
    "typescript": "~6.0.3"
  }
}
