{
  "name": "@smithers-orchestrator/aws",
  "version": "0.28.0",
  "description": "AWS Fargate (ECS) and CodeBuild sandbox provider for Smithers, using S3 as the bundle transport",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smithers-orchestrator/sandbox": "workspace:*",
    "@smithers-orchestrator/errors": "workspace:*"
  },
  "optionalDependencies": {
    "@aws-sdk/client-ecs": "^3.700.0",
    "@aws-sdk/client-codebuild": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  }
}
