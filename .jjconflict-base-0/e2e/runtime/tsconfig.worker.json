{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "smithers-orchestrator",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types/latest"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["cloudflare-worker.js", "fixture.js"]
}
