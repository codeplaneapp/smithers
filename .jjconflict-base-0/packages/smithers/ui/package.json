{
  "name": "@smthrs/ui",
  "version": "1.0.0-rc.0",
  "smthrs": {
    "group": "agent"
  },
  "private": true,
  "description": "Shared shadcn-anatomy component library for Smithers UIs. Radix primitives + CVA variant APIs styled with the ui-styleguide theme tokens, shipped as CSS-in-TS strings so components bundle through the gateway's Bun.build and follow light/dark (prefers-color-scheme and data-theme) with zero configuration.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./adapters/knowledge-graph": {
      "types": "./src/adapters/knowledge-graph.ts",
      "import": "./src/adapters/knowledge-graph.ts",
      "default": "./src/adapters/knowledge-graph.ts"
    },
    "./adapters/chart": {
      "types": "./src/adapters/chart.tsx",
      "import": "./src/adapters/chart.tsx",
      "default": "./src/adapters/chart.tsx"
    },
    "./adapters/markdown-editor": {
      "types": "./src/adapters/markdown-editor/index.ts",
      "import": "./src/adapters/markdown-editor/index.ts",
      "default": "./src/adapters/markdown-editor/index.ts"
    },
    "./adapters/pierre-diff-view": {
      "types": "./src/adapters/pierre-diff-view.tsx",
      "import": "./src/adapters/pierre-diff-view.tsx",
      "default": "./src/adapters/pierre-diff-view.tsx"
    },
    "./adapters/code-view": {
      "types": "./src/adapters/code-view/index.ts",
      "import": "./src/adapters/code-view/index.ts",
      "default": "./src/adapters/code-view/index.ts"
    },
    "./adapters/terminal": {
      "types": "./src/adapters/terminal.tsx",
      "import": "./src/adapters/terminal.tsx",
      "default": "./src/adapters/terminal.tsx"
    },
    "./status": {
      "types": "./src/status.ts",
      "import": "./src/status.ts",
      "default": "./src/status.ts"
    },
    "./time": {
      "types": "./src/time/index.ts",
      "import": "./src/time/index.ts",
      "default": "./src/time/index.ts"
    },
    "./calendar": {
      "types": "./src/calendar/index.ts",
      "import": "./src/calendar/index.ts",
      "default": "./src/calendar/index.ts"
    },
    "./vault": {
      "types": "./src/vault/index.ts",
      "import": "./src/vault/index.ts",
      "default": "./src/vault/index.ts"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@milkdown/crepe": "7.21.2",
    "@milkdown/kit": "7.21.2",
    "@milkdown/plugin-listener": "7.21.2",
    "@pierre/diffs": "^1.2.12",
    "@smthrs/ui-styleguide": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "3.0.0",
    "radix-ui": "^1.6.1",
    "recharts": "^3.2.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/d3-force": "^3.0.10",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "~6.0.3"
  }
}
