{
  "name": "@smthrs/targets",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "smthrs": {
    "group": "tooling"
  },
  "private": true,
  "description": "Typed legacy declaration rules and macros for smithers build",
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null
  },
  "files": [
    "src/**/*.ts",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest"
  },
  "dependencies": {
    "@smthrs/canonical": "1.0.0-rc.0",
    "@smthrs/crypto": "1.0.0-rc.0",
    "@smthrs/database": "1.0.0-rc.0",
    "@smthrs/flow": "1.0.0-rc.0",
    "@smthrs/keys": "1.0.0-rc.0",
    "@smthrs/plan": "1.0.0-rc.0",
    "@smthrs/build": "workspace:*",
    "ignore": "7.0.6",
    "minimatch": "10.2.6",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.108"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@eslint/js": "9.39.1",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.55.2",
    "effect": "4.0.0-rc.108",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.1.0",
    "eslint-plugin-unicorn": "61.0.2",
    "madge": "8.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.9"
  }
}
