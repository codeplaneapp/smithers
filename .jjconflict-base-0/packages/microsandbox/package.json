{
  "name": "@smithers-orchestrator/microsandbox",
  "version": "0.29.0",
  "description": "Microsandbox provider for Smithers: run sandboxed workflows in local microVMs",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "rm -f src/index.d.ts && tsup --dts-only",
    "test": "bun test tests --path-ignore-patterns '**/realMicrosandbox.test.js'",
    "test:real": "bun test tests/realMicrosandbox.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smithers-orchestrator/errors": "workspace:*",
    "@smithers-orchestrator/sandbox": "workspace:*"
  },
  "optionalDependencies": {
    "microsandbox": "0.6.6"
  },
  "devDependencies": {
    "@superradcompany/microsandbox-darwin-arm64": "0.6.6",
    "@superradcompany/microsandbox-linux-arm64-gnu": "0.6.6",
    "@superradcompany/microsandbox-linux-x64-gnu": "0.6.6",
    "@superradcompany/microsandbox-win32-arm64-msvc": "0.6.6",
    "@superradcompany/microsandbox-win32-x64-msvc": "0.6.6",
    "@types/bun": "latest",
    "microsandbox-test-sdk": "npm:microsandbox@0.6.6",
    "typescript": "~6.0.3"
  }
}
