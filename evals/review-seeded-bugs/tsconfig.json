{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The suite reaches the review app, whose walkthrough renderer and server
    // sources are typed against DOM, as the modules that own them declare.
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "inlineSources": false,
    "sourceMap": false
  },
  "include": ["*.ts"],
  "exclude": ["BUILD.ts", "*.test.ts"]
}
