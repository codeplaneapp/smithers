{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": [
    "test/fixtures/force-spec/**/*",
    "test/fixtures/rsbuild-mini/**/*",
    "test/fixtures/viem-node-spec/**/*"
  ]
}
