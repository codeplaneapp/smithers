# The 1.0 CLI links removed 0.x spellings to https://smithers.sh/migration/1.0#<anchor>
# (packages/smithers/src/Unsupported.ts). A 301 keeps the fragment; an Astro
# redirect page (meta refresh) drops it, so this file is the redirect.
/migration/1.0  /docs/migration/1.0/  301
/migration/1.0/  /docs/migration/1.0/  301

# Recover the pre-Starlight routes while preserving their fragments.
# Order is load-bearing because Netlify uses the first matching rule. Explicit
# compatibility routes must precede the API splat that would swallow them.
/api/patterns-teams  /docs/reference/api/patterns/  301
/api/patterns-teams/ /docs/reference/api/patterns/  301
/api/patterns-loops  /docs/reference/api/patterns/  301
/api/patterns-loops/ /docs/reference/api/patterns/  301
/api/*        /docs/reference/api/:splat/       301
/reference/*  /docs/reference/:splat/           301

# Concept slugs are explicit because renamed or removed concepts must not be
# laundered through a splat into a 404.
/concepts/agent-runtime          /docs/concepts/agent-runtime/          301
