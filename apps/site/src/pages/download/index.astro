---
import Base from "../../layouts/Base.astro"
/*
 * The version on this page is the CLI's own manifest, read at build time, so
 * the page can never advertise a release the tree does not carry.
 */
import cliManifest from "../../../../../packages/smithers/package.json"

const version: string = cliManifest.version
const tag = `v${version}`
const release = `https://github.com/smithersai/smithers/releases/tag/${tag}`
const asset = (name: string) => `https://github.com/smithersai/smithers/releases/download/${tag}/${name}`

const binaries = [
  { os: "macOS", arch: "Apple silicon", file: `Smithers-${version}-macos-arm64.dmg` },
  { os: "macOS", arch: "Intel", file: `Smithers-${version}-macos-x64.dmg` },
  { os: "Linux", arch: "x64", file: `Smithers-${version}-linux-x64.tar.gz` },
  { os: "Windows", arch: "x64", file: `Smithers-${version}-windows-x64.zip` }
]
---

<Base title="Download Smithers" description={`Download Smithers ${version} for macOS, Linux, and Windows, install the command line, or build it from source.`}>
  <main class="wrap dl">
    <p class="version"><span>Current version</span> <code>{version}</code></p>
    <h1>Download Smithers</h1>
    <p class="lead">The desktop app, the command line, and the source. Every download on this page is release <a href={release}>{tag}</a>.</p>

    <section>
      <h2>Desktop app</h2>
      <ul class="grid">
        {binaries.map((b) => (
          <li>
            <a class="card" href={asset(b.file)}>
              <b>{b.os}</b>
              <span>{b.arch}</span>
              <code>{b.file}</code>
            </a>
          </li>
        ))}
      </ul>
      <p class="note">Every artifact is attached to the <a href={release}>{tag} release on GitHub</a> with its checksum.</p>
    </section>

    <section>
      <h2>Command line</h2>
      <p>Requires Node.js 22.19 or later. Release candidates publish to the <code>next</code> dist-tag.</p>
      <pre><code>npm install --global @smthrs/cli@next
smthrs doctor</code></pre>
    </section>

    <section class="source">
      <h2>Build from source</h2>
      <p>The engine, the command line, and the app live in one MIT-licensed repository.</p>
      <div class="actions left">
        <a class="btn primary" href="https://github.com/smithersai/smithers">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
          Build from source
        </a>
        <a class="btn" href="/docs/installation/">Install guide</a>
      </div>
      <pre><code>git clone https://github.com/smithersai/smithers
cd smithers
pnpm install --frozen-lockfile
pnpm exec smthrs doctor</code></pre>
    </section>
  </main>
</Base>

<style>
  .dl { padding: 2.5rem 0 3rem; max-width: 760px; }
  .version { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.35rem 0.7rem 0.35rem 0.9rem; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--surface); font-size: 0.85rem; color: var(--text-muted); margin: 0 0 1.2rem; }
  .version code { font-weight: 600; color: var(--brand); font-size: 0.95rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.03em; margin: 0 0 0.6rem; }
  .lead { color: var(--text-muted); font-size: 1.1rem; margin: 0 0 2.2rem; }
  .lead a, .note a { text-decoration: underline; text-underline-offset: 3px; }
  section { margin-bottom: 2.6rem; }
  h2 { font-size: 1.15rem; margin: 0 0 0.7rem; letter-spacing: -0.01em; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.8rem; }
  .card { display: flex; flex-direction: column; gap: 0.2rem; padding: 1rem; border-radius: 12px; border: 1px solid var(--border-strong); background: var(--surface); transition: transform 180ms var(--ease), box-shadow 180ms var(--ease); }
  .card:hover { transform: translateY(-2px); box-shadow: var(--shadow-2); }
  .card b { font-size: 1rem; }
  .card span { color: var(--text-muted); font-size: 0.9rem; }
  .card code { font-size: 0.72rem; color: var(--text-faint); margin-top: 0.5rem; word-break: break-all; }
  .note { font-size: 0.85rem; color: var(--text-faint); margin: 0.8rem 0 0; }
  pre { margin: 0.8rem 0 0; padding: 1rem 1.1rem; border-radius: 12px; background: var(--code-bg); color: var(--code-text); border: 1px solid var(--border); overflow-x: auto; font-size: 0.85rem; line-height: 1.6; }
  .actions.left { justify-content: flex-start; margin-top: 0.9rem; }
  p code { padding: 0.1em 0.4em; border-radius: 5px; background: var(--surface-2); font-size: 0.9em; }
</style>
