---
/*
 * The nomination form. On the landing page it is open: a visitor names any
 * repository. On a coming-soon repository page it is pre-filled with that
 * repository, so the visitor nominates it and leaves an email in one step.
 */
interface Props {
  repo?: { readonly name: string; readonly title: string; readonly url: string }
}
const { repo } = Astro.props
const endpoint = import.meta.env.PUBLIC_REPO_REQUESTS_URL || "https://bug.smithers.sh/api/repo-requests"
---

<section class="requests wrap" aria-labelledby="request-title" data-repo-requests data-endpoint={endpoint}>
  <div class="request-card">
    <div class="intro">
      {repo
        ? <h2 id="request-title">Nominate {repo.title}</h2>
        : <h2 id="request-title">What should we smither next?</h2>}
      {repo
        ? <p>Smithers is in private alpha. Nominations decide which repositories open next; leave an email and we send one message when {repo.title} opens.</p>
        : <p>Smithers is in private alpha and only available to a select number of open source repos</p>}
    </div>
    <form data-request-form>
      <label for="repo-url">GitHub repository</label>
      <input id="repo-url" name="repo" type="text" value={repo?.url} placeholder="https://github.com/owner/repo" required maxlength="250" autocapitalize="none" spellcheck="false" aria-describedby="repo-help" />
      <p class="hint" id="repo-help">A public repo with an open-source license. It doesn’t have to be yours.</p>
      <label for="repo-email">Email <span class="optional">(optional)</span></label>
      <input id="repo-email" name="email" type="email" placeholder="you@example.com" maxlength="254" autocomplete="email" aria-describedby="email-help" />
      <p class="hint" id="email-help">One email when it’s ready. Your email stays private.</p>
      <button class="btn primary" type="submit">Smither this repo <span aria-hidden="true">↗</span></button>
      <p class="feedback" data-feedback role="status" aria-live="polite"></p>
    </form>
    <aside class="most-nominated" data-most-nominated hidden aria-labelledby="most-nominated-title">
      <h3 id="most-nominated-title">Most nominated</h3>
      <ol data-most-nominated-list></ol>
    </aside>
  </div>
  <noscript>Enable JavaScript to submit a repo.</noscript>
</section>

<style>
  .requests { max-width: 1040px; margin-top: 1.6rem; margin-bottom: 4rem; }
  .request-card { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--border-strong); border-radius: 20px; background: var(--surface); box-shadow: var(--shadow-2); }
  h2 { margin: 0 0 1rem; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.1; letter-spacing: -.035em; }
  .intro p { color: var(--text-muted); line-height: 1.65; margin: 0; }
  form { display: flex; flex-direction: column; align-self: center; }
  label { font-size: .86rem; font-weight: 600; margin-bottom: .5rem; }
  .optional { font-weight: 400; color: var(--text-faint); }
  input { width: 100%; box-sizing: border-box; padding: .85rem 1rem; border: 1px solid var(--border-strong); border-radius: 10px; background: var(--bg); color: var(--text); font: inherit; font-size: .9rem; }
  input:focus { outline: 2px solid var(--brand); outline-offset: 2px; }
  input::placeholder { color: var(--text-faint); }
  .hint { color: var(--text-muted); font-size: .77rem; line-height: 1.5; margin: .5rem 0 1.25rem; }
  button { font-family: inherit; cursor: pointer; justify-content: center; }
  button:disabled { opacity: .6; cursor: wait; }
  .feedback { font-size: .85rem; line-height: 1.5; margin: .8rem 0 0; }
  .feedback[data-error="true"] { color: var(--warning); }
  .most-nominated { grid-column: 2; padding-top: 1.25rem; border-top: 1px solid var(--border-strong); }
  .most-nominated h3 { margin: 0 0 .6rem; font-size: .86rem; font-weight: 600; }
  .most-nominated ol { display: flex; flex-direction: column; gap: .35rem; margin: 0; padding: 0; list-style: none; }
  .most-nominated li { display: flex; justify-content: space-between; gap: 1rem; font-size: .85rem; line-height: 1.5; }
  .most-nominated a { color: var(--text); text-decoration: none; overflow-wrap: anywhere; }
  .most-nominated a:hover { text-decoration: underline; }
  .most-nominated .tally { color: var(--text-muted); font: .78rem var(--font-mono); white-space: nowrap; }
  @media (max-width: 720px) { .request-card { grid-template-columns: 1fr; gap: 2rem; } .most-nominated { grid-column: auto; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-repo-requests]")!
  const endpoint = root.dataset.endpoint!
  const form = root.querySelector<HTMLFormElement>("[data-request-form]")!
  const repoInput = form.elements.namedItem("repo") as HTMLInputElement
  const emailInput = form.elements.namedItem("email") as HTMLInputElement
  const submit = form.querySelector<HTMLButtonElement>("button")!
  const feedback = root.querySelector<HTMLElement>("[data-feedback]")!
  const mostNominated = root.querySelector<HTMLElement>("[data-most-nominated]")!
  const mostNominatedList = root.querySelector<HTMLElement>("[data-most-nominated-list]")!
  type PublicRepo = { name: string; url: string; status: string; nominations: number }
  const validCount = (value: unknown): value is number => typeof value === "number" && Number.isSafeInteger(value) && value >= 0
  const label = (count: number) => `${count} ${count === 1 ? "nomination" : "nominations"}`
  // The list is decoration: any failure leaves it hidden and the form untouched.
  const loadMostNominated = async (cache: RequestCache = "default") => {
    try {
      const response = await fetch(endpoint, { credentials: "omit", cache, signal: AbortSignal.timeout(15_000) })
      if (!response.ok) throw new Error()
      const data = await response.json() as { repos?: unknown }
      const repos = (Array.isArray(data.repos) ? data.repos : [])
        .filter((repo): repo is PublicRepo => typeof repo?.name === "string" && typeof repo?.url === "string" && validCount(repo?.nominations))
        .filter((repo) => repo.nominations > 0)
        .slice(0, 5)
      mostNominatedList.replaceChildren(...repos.map((repo) => {
        const item = document.createElement("li")
        const link = document.createElement("a")
        link.href = repo.url
        link.textContent = repo.name
        const count = document.createElement("span")
        count.className = "tally"
        count.textContent = label(repo.nominations)
        item.append(link, count)
        return item
      }))
      mostNominated.hidden = repos.length === 0
    } catch {
      mostNominated.hidden = true
    }
  }
  void loadMostNominated()
  form.addEventListener("submit", async (event) => {
    event.preventDefault()
    if (!form.reportValidity()) return
    submit.disabled = true
    submit.textContent = "Submitting…"
    feedback.textContent = ""
    feedback.dataset.error = "false"
    try {
      const response = await fetch(endpoint, {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ repo: repoInput.value.trim(), email: emailInput.value.trim() }),
        signal: AbortSignal.timeout(20_000),
      })
      const data = await response.json()
      if (!response.ok) throw new Error(data.error || "We couldn’t submit that repo. Please try again.")
      const status = data.repo.status === "ready"
        ? `${data.repo.name} is already supported.`
        : `${data.repo.name} is now being smithered.${data.subscribed ? " We’ll email you when it’s ready." : ""}`
      feedback.textContent = validCount(data.repo.nominations) ? `${label(data.repo.nominations)} for ${data.repo.name}. ${status}` : status
      emailInput.value = ""
      // The Worker lets browsers reuse the list for a minute; a fresh nomination should show now.
      void loadMostNominated("reload")
    } catch (error) {
      feedback.dataset.error = "true"
      feedback.textContent = error instanceof Error && error.name === "Error" ? error.message : "We couldn’t submit that repo. Please try again."
    } finally { submit.disabled = false; submit.textContent = "Smither this repo ↗" }
  })
</script>
