---
/*
 * The page for one coming-soon repository at /<owner>/<name>: what the
 * repository is on GitHub, that it opens as its maintainers register it, and
 * the registration call to action. A page of the site on the Base layout,
 * not the app shell: there is no app to open here until the repository is
 * registered and moves to AVAILABLE_REPOS.
 */
import Base from "../layouts/Base.astro"
import RegisterRepo from "./RegisterRepo.astro"
import { PUBLIC_REPOS_PATH } from "../../../server/src/publicRepoCatalog"

interface Props {
  repo: { readonly name: string; readonly title: string; readonly url: string }
}
const { repo } = Astro.props
/* The app Worker (apps/server) serves the catalog under smithers.sh, beside this static site. */
const endpoint = import.meta.env.PUBLIC_AVAILABLE_REPOS_URL || `https://smithers.sh${PUBLIC_REPOS_PATH}`
const title = `${repo.title} on Smithers: coming soon`
const description = `${repo.name} opens on Smithers as its maintainers register it: sign in with GitHub, then install the Smithers GitHub App on the repository.`
---

<Base title={title} description={description}>
  <main class="wrap repo-page">
    <p class="back"><a href="/">← All repos</a></p>
    <article class="repo" data-coming-soon-repo data-endpoint={endpoint} data-repo={repo.name} aria-labelledby="repo-title repo-badge">
      <div class="title-row">
        <h1 id="repo-title">{repo.title}</h1>
        <span id="repo-badge" class="badge">Coming soon</span>
      </div>
      <a class="repo-name" href={repo.url}>{repo.name} <span aria-hidden="true">↗</span></a>
      <p class="explain">This repository opens as its maintainers register it.</p>
      <dl class="stats" aria-busy="true" data-stats>
        <div><dt>Stars</dt><dd data-stat="stars">…</dd></div>
        <div><dt>Forks</dt><dd data-stat="forks">…</dd></div>
        <div><dt>Issues + PRs</dt><dd data-stat="openIssuesAndPulls">…</dd></div>
      </dl>
      <div class="card-footer">
        <span class="repo-meta" data-meta></span>
        <span class="stats-status" data-stats-status role="status">Loading stats…</span>
      </div>
    </article>
  </main>
  <RegisterRepo />
</Base>

<style>
  .repo-page { max-width: 1040px; padding: 2rem 0 0; }
  .back { margin: 0 0 1.5rem; font-size: .9rem; }
  .back a { color: var(--text-muted); text-decoration: none; }
  .back a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .repo { padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--border-strong); border-radius: 20px; background: var(--surface); box-shadow: var(--shadow-2); }
  .title-row { display: flex; align-items: center; flex-wrap: wrap; gap: .8rem; margin: 0 0 .5rem; }
  h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.05; letter-spacing: -.035em; }
  .badge { display: inline-block; padding: .25rem .6rem; border: 1px solid var(--border-strong); border-radius: 5px; color: var(--text-muted); font: 600 .68rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .08em; white-space: nowrap; }
  .repo-name { display: inline-flex; gap: .6rem; color: var(--text-muted); font: .82rem/1.7 var(--font-mono); overflow-wrap: anywhere; }
  .repo-name:hover { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }
  .explain { margin: 1rem 0 0; color: var(--text-muted); line-height: 1.65; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 32rem; margin: 1.5rem 0 0; padding: 1rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .stats > div + div { border-left: 1px solid var(--border); padding-left: 1rem; }
  dt { font: .65rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .04em; color: var(--text-faint); }
  dd { margin: .35rem 0 0; font: 600 1.4rem/1.3 var(--font-mono); font-variant-numeric: tabular-nums; }
  .card-footer { display: flex; align-items: center; flex-wrap: wrap; min-height: 2.1rem; padding-top: .7rem; gap: .4rem; color: var(--text-faint); font: .72rem/1.4 var(--font-mono); }
  .stats-status:empty { display: none; }
</style>

<script>
  import { fillRepoStats } from "./repoStats"

  /* This page's only card is the article itself, not a descendant of it. */
  const card = document.querySelector<HTMLElement>("[data-coming-soon-repo]")
  if (card) void fillRepoStats(card.dataset.endpoint!, [card])
</script>
