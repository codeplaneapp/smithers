{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "smithers-site",
  "compatibility_date": "2026-07-02",
  "workers_dev": false,
  // The whole site is static output from `astro build`: the landing page, the
  // download page, and the Starlight docs under /docs. Assets-only, no Worker
  // script, so a deploy is `pnpm run build && wrangler deploy`.
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "smithers.sh",
      "custom_domain": true
    }
  ]
}
