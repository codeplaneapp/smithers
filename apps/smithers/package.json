{
  "name": "@smithers-orchestrator/smithers-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Local-only Smithers UI: the full run/approval/memory/scores control surface, talking to a local `smithers gateway` over RPC/WS. No cloud, no auth.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --max-concurrency=1 --path-ignore-patterns=\"**/e2e/**\"",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "concierge": "bun concierge/server.ts",
    "dev:full": "bun concierge/server.ts & vite --host 127.0.0.1 --port 5180"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@pierre/diffs": "^1.2.11",
    "@pierre/trees": "1.0.0-beta.4",
    "ai": "^6.0.168",
    "@smithers-orchestrator/gateway-client": "workspace:*",
    "@smithers-orchestrator/gateway-react": "workspace:*",
    "@smithers-orchestrator/gateway-ui": "workspace:*",
    "@tanstack/db": "^0.6.8",
    "@tanstack/react-db": "^0.1.86",
    "@tanstack/react-router": "^1.135.5",
    "@tanstack/react-virtual": "^3.14.3",
    "@xyflow/react": "^12.10.2",
    "dagre": "^0.8.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.60.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "bun-types": "^1.3.14",
    "smithers-orchestrator": "workspace:*",
    "typescript": "~5.9.3",
    "vite": "^8.0.14",
    "zod": "4.3.6"
  }
}
