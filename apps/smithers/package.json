{
  "name": "@smthrs/smithers-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Local-only Smithers UI: the full run/approval/memory/scores control surface, talking to a local `smithers gateway` over RPC/WS. No cloud, no auth.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --max-concurrency=1 --path-ignore-patterns=\"**/e2e/**\"",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "concierge": "bun concierge/server.ts",
    "dev:full": "bun concierge/server.ts & vite --host 127.0.0.1 --port 5180"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.5",
    "@pierre/diffs": "^1.2.12",
    "@pierre/trees": "1.0.0-beta.5",
    "@smthrs/gateway-client": "workspace:*",
    "@smthrs/gateway-react": "workspace:*",
    "@smthrs/gateway-ui": "workspace:*",
    "@smthrs/ui": "workspace:*",
    "@tanstack/ai": "^0.39.0",
    "@tanstack/ai-openai": "^0.15.10",
    "@tanstack/db": "^0.6.13",
    "@tanstack/react-db": "^0.1.91",
    "@tanstack/react-router": "^1.135.5",
    "@tanstack/react-virtual": "^3.14.5",
    "@xyflow/react": "^12.10.2",
    "ai": "^7.0.10",
    "dagre": "^0.8.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@playwright/test": "^1.60.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "bun-types": "^1.3.14",
    "smthrs": "workspace:*",
    "typescript": "~6.0.3",
    "vite": "^8.1.2",
    "zod": "4.4.3"
  }
}
