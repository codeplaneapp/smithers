{
  "name": "smithers-tui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Terminal chat client for the Smithers MVP app: an opentui (React) clone of apps/ui that speaks the same agent turn contract",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.3",
    "@opentui/react": "0.5.3",
    "react": "19.2.7",
    "smithers-shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.2.17",
    "@types/ws": "^8.18.1",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  }
}
