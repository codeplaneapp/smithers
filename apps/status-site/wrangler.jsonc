{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "status-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-02",
  "workers_dev": true,
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "status.smithers.sh",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
