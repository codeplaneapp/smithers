{
  "name": "@smithers-orchestrator/storybook-site",
  "version": "0.0.1",
  "private": true,
  "description": "Storybook catalog for the shared Smithers UI component library, deployed at storybook.smithers.sh",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build -o site",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "storybook build -o site && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "destroy": "wrangler delete storybook-site"
  },
  "dependencies": {
    "@smithers-orchestrator/ui": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.3",
    "@types/node": "26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.14",
    "storybook": "^10.5.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.2",
    "wrangler": "^4.106.0"
  }
}
