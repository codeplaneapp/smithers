{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "storybook-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-16",
  "workers_dev": true,
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    // "none" keeps /iframe.html verbatim: the default auto-trailing-slash
    // handling 307s it to /iframe and DROPS the ?id= query, breaking story
    // deep links. The worker itself falls back to /index.html on 404s.
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "routes": [
    {
      "pattern": "storybook.smithers.sh",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
