{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "research-site",
  "compatibility_date": "2026-07-02",
  "workers_dev": true,
  "assets": {
    "directory": "site"
  },
  "routes": [
    {
      "pattern": "research.smithers.sh",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
