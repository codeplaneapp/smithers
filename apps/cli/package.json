{
  "name": "@smithers-orchestrator/cli",
  "version": "0.30.0",
  "description": "Smithers command-line interface, MCP server, and local workflow tools",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/",
    "dist/",
    "docs/",
    "ui-dist/"
  ],
  "scripts": {
    "test": "bun test --timeout=120000 --max-concurrency=1 tests/monitor-shell-controls.test.tsx && bun test --timeout=120000 --max-concurrency=1 --path-ignore-patterns=\"**/monitor-shell-controls.test.tsx\" tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup --dts-only",
    "build:ui": "node scripts/build-ui.mjs",
    "prepack": "node scripts/build-ui.mjs"
  },
  "dependencies": {
    "@clack/core": "^1.4.2",
    "@clack/prompts": "^1.6.0",
    "@effect/workflow": "^0.18.2",
    "@mdx-js/esbuild": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pierre/diffs": "^1.2.11",
    "@opentui/core": "^0.4.2",
    "@opentui/react": "^0.4.2",
    "@smithers-orchestrator/accounts": "workspace:*",
    "@smithers-orchestrator/agents": "workspace:*",
    "@smithers-orchestrator/components": "workspace:*",
    "@smithers-orchestrator/db": "workspace:*",
    "@smithers-orchestrator/devtools": "workspace:*",
    "@smithers-orchestrator/driver": "workspace:*",
    "@smithers-orchestrator/engine": "workspace:*",
    "@smithers-orchestrator/errors": "workspace:*",
    "@smithers-orchestrator/graph": "workspace:*",
    "@smithers-orchestrator/memory": "workspace:*",
    "@smithers-orchestrator/observability": "workspace:*",
    "@smithers-orchestrator/openapi": "workspace:*",
    "@smithers-orchestrator/protocol": "workspace:*",
    "@smithers-orchestrator/review": "workspace:*",
    "@smithers-orchestrator/scheduler": "workspace:*",
    "@smithers-orchestrator/scorers": "workspace:*",
    "@smithers-orchestrator/server": "workspace:*",
    "@smithers-orchestrator/time-travel": "workspace:*",
    "@smithers-orchestrator/tui": "workspace:*",
    "@smithers-orchestrator/usage": "workspace:*",
    "@smithers-orchestrator/vcs": "workspace:*",
    "@toon-format/toon": "2.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cron-parser": "^5.6.1",
    "drizzle-orm": "^0.45.2",
    "effect": "3.21.4",
    "incur": "^0.4.10",
    "picocolors": "^1.1.1",
    "react": "^19.2.7",
    "smithers-orchestrator": "workspace:*",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.61.1",
    "typescript": "~6.0.3"
  }
}
