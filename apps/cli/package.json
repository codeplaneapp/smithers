{
  "name": "@smthrs/cli",
  "version": "0.33.1",
  "description": "Smithers command-line interface, MCP server, and local workflow tools",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/",
    "dist/",
    "docs/",
    "ui-dist/"
  ],
  "scripts": {
    "test": "bun test --timeout=120000 --max-concurrency=1 tests/monitor-shell-controls.test.tsx && bun ./scripts/run-test-shards.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup --dts-only",
    "build:ui": "node scripts/build-ui.mjs",
    "prepack": "node scripts/build-ui.mjs"
  },
  "dependencies": {
    "@clack/core": "^1.4.2",
    "@clack/prompts": "^1.6.0",
    "@mdx-js/esbuild": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentui/core": "^0.4.2",
    "@opentui/react": "^0.4.2",
    "@pierre/diffs": "^1.2.11",
    "@smthrs/accounts": "workspace:*",
    "@smthrs/agents": "workspace:*",
    "@smthrs/components": "workspace:*",
    "@smthrs/db": "workspace:*",
    "@smthrs/devtools": "workspace:*",
    "@smthrs/driver": "workspace:*",
    "@smthrs/engine": "workspace:*",
    "@smthrs/errors": "workspace:*",
    "@smthrs/graph": "workspace:*",
    "@smthrs/herdr": "workspace:*",
    "@smthrs/memory": "workspace:*",
    "@smthrs/observability": "workspace:*",
    "@smthrs/openapi": "workspace:*",
    "@smthrs/protocol": "workspace:*",
    "@smthrs/review": "workspace:*",
    "@smthrs/scheduler": "workspace:*",
    "@smthrs/scorers": "workspace:*",
    "@smthrs/server": "workspace:*",
    "@smthrs/time-travel": "workspace:*",
    "@smthrs/tui": "workspace:*",
    "@smthrs/usage": "workspace:*",
    "@smthrs/vcs": "workspace:*",
    "@toon-format/toon": "2.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cron-parser": "^5.6.1",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.105",
    "incur": "^0.4.10",
    "picocolors": "^1.1.1",
    "react": "^19.2.7",
    "smthrs": "workspace:*",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.61.1",
    "typescript": "~6.0.3"
  }
}
