{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "bun-types",
      "node"
    ],
    "baseUrl": "."
  },
  "include": [
    "src",
    "../../../.smithers/lib/daily-ceo-intel"
  ]
}
