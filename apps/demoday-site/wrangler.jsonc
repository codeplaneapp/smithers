{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "demoday-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-16",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "routes": [
    {
      "pattern": "demoday.smithers.sh",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
