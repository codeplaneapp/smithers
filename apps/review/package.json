{
  "name": "@smthrs/review",
  "version": "1.0.0-rc.0",
  "description": "Code review plus story-form HTML walkthrough, as a Smithers flow",
  "license": "MIT",
  "type": "module",
  "smthrs": {
    "group": "agent"
  },
  "bin": {
    "smithers-review": "./bin/smithers-review.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./cli": "./src/cli/main.ts",
    "./diffs": "./src/diffs/index.ts",
    "./workflow": "./src/workflow/reviewFlow.ts",
    "./workflow/layer": "./src/workflow/reviewLayer.ts",
    "./workflow/openCodeReview": "./src/workflow/openCodeReview.ts"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "bun ./src/cli/main.ts",
    "test": "bun test tests",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "@pierre/diffs": "^1.2.12",
    "@smthrs/agent": "1.0.0-rc.0",
    "@smthrs/engine": "1.0.0-rc.0",
    "@smthrs/flow": "1.0.0-rc.0",
    "@smthrs/flows": "1.0.0-rc.0",
    "@smthrs/harness": "1.0.0-rc.0",
    "@smthrs/kernel": "1.0.0-rc.0",
    "@smthrs/model": "1.0.0-rc.0",
    "@smthrs/plan": "1.0.0-rc.0",
    "@smthrs/registry": "1.0.0-rc.0",
    "@smthrs/ui-styleguide": "1.0.0-rc.0",
    "effect": "4.0.0-rc.108",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "alchemy": "^0.93.12",
    "bun-types": "^1.3.14",
    "typescript": "~6.0.3",
    "yaml": "^2.8.1"
  }
}
