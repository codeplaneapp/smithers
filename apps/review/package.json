{
  "name": "@smthrs/review",
  "version": "0.33.0",
  "description": "Code review plus story-form HTML walkthrough, built on the OpenCodeReview-derived review flow",
  "license": "MIT",
  "type": "module",
  "bin": {
    "smithers-review": "./src/cli/main.ts"
  },
  "exports": {
    "./cli": "./src/cli/main.ts",
    "./diffs": "./src/diffs/index.ts",
    "./workflow/openCodeReview": "./src/workflow/openCodeReview.ts"
  },
  "files": [
    "src/",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "bun ./src/cli/main.ts",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "@pierre/diffs": "^1.2.12",
    "@smthrs/agents": "workspace:*",
    "@smthrs/db": "workspace:*",
    "@smthrs/engine": "workspace:*",
    "@smthrs/ui-styleguide": "workspace:*",
    "effect": "4.0.0-beta.102",
    "mermaid": "^11.16.0",
    "smthrs": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "alchemy": "^0.93.12",
    "bun-types": "^1.3.14",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "~6.0.3"
  }
}
