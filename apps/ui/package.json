{
  "name": "smithers-ui",
  "private": true,
  "version": "1.0.0",
  "description": "Smithers closed-alpha native app",
  "scripts": {
    "postinstall": "node scripts/ensure-devkit.mjs --soft",
    "devkit": "node scripts/ensure-devkit.mjs",
    "start": "node scripts/ensure-devkit.mjs && vite build --configLoader runner && electrobun dev",
    "dev": "electrobun dev --watch",
    "build": "node scripts/ensure-devkit.mjs && vite build --configLoader runner && electrobun build",
    "typecheck": "node scripts/ensure-devkit.mjs && tsc --noEmit",
    "check": "node scripts/ensure-devkit.mjs && tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "test:e2e:native": "bun e2e/playwright/native/run.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@journeyapps/wa-sqlite": "1.7.2",
    "@smthrs/canonical": "workspace:*",
    "@smthrs/capability": "workspace:*",
    "@smthrs/chain": "workspace:*",
    "@smthrs/core": "workspace:*",
    "@smthrs/crypto": "workspace:*",
    "@smthrs/database": "workspace:*",
    "@smthrs/harness": "workspace:*",
    "@smthrs/jj": "workspace:*",
    "@smthrs/journal": "workspace:*",
    "@smthrs/kernel": "workspace:*",
    "@smthrs/memory": "workspace:*",
    "@smthrs/model": "workspace:*",
    "@smthrs/patterns": "workspace:*",
    "@smthrs/platform-browser": "workspace:*",
    "@smthrs/registry": "workspace:*",
    "@smthrs/ui": "0.33.0",
    "@standard-schema/spec": "1.1.0",
    "@tanstack/browser-db-sqlite-persistence": "0.2.9",
    "@tanstack/db": "0.6.17",
    "@tanstack/react-db": "0.1.95",
    "@xyflow/react": "^12.11.5",
    "dagre": "^0.8.5",
    "effect": "4.0.0-rc.108",
    "electrobun": "2.0.1",
    "lucide-react": "1.28.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "smithers-shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@playwright/test": "1.62.1",
    "@types/bun": "latest",
    "@types/d3-force": "3.0.10",
    "@types/dagre": "0.7.53",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.1",
    "autoprefixer": "^10.4.20",
    "playwright": "1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "8.2.1"
  }
}
