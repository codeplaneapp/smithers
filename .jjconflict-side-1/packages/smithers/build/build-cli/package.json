{
  "name": "@smthrs/build-cli",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "smthrs": {
    "group": "tooling"
  },
  "private": true,
  "description": "Executes PACKAGE.ts target graphs with content-addressed caching",
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [
    "./src/main.js",
    "./src/Workspace.ts",
    "./src/PackageLoader.ts"
  ],
  "bin": {
    "smithers-build": "./src/main.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null
  },
  "files": [
    "src/**/*.js",
    "src/**/*.ts",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "@effect/platform-node-shared": "4.0.0-rc.108",
    "@smthrs/canonical": "1.0.0-rc.0",
    "@smthrs/create-app": "workspace:*",
    "@smthrs/crypto": "1.0.0-rc.0",
    "@smthrs/engine": "1.0.0-rc.0",
    "@smthrs/flow": "1.0.0-rc.0",
    "@smthrs/keys": "1.0.0-rc.0",
    "@smthrs/plan": "1.0.0-rc.0",
    "@smthrs/build": "workspace:*",
    "effect": "4.0.0-rc.108",
    "ignore": "7.0.6",
    "incur": "0.5.1",
    "minimatch": "10.2.6",
    "@smthrs/targets": "workspace:*",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@eslint/js": "9.39.1",
    "@rsbuild/core": "1.2.3",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.55.2",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.1.0",
    "eslint-plugin-unicorn": "61.0.2",
    "madge": "8.0.0",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.9"
  }
}
