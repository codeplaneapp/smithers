      ],
      "@smthrs/sandbox/*": [
        "./packages/sandbox/src/*.js",
        "./packages/sandbox/src/*/index.js"
      ],
      "@smthrs/scorers": [
        "./packages/scorers/src/index.js"
      ],
      "@smthrs/scorers/*": [
        "./packages/scorers/src/*.js",
        "./packages/scorers/src/*/index.js"
      ],
      "@smthrs/scheduler": [
        "./packages/scheduler/src/index.js"
      ],
      "@smthrs/scheduler/*": [
        "./packages/scheduler/src/*.ts",
        "./packages/scheduler/src/*.js",
        "./packages/scheduler/src/*/index.js"
      ],
      "@smthrs/server": [
        "./packages/server/src/index.js"
      ],
      "@smthrs/server/*": [
        "./packages/server/src/*.js",
        "./packages/server/src/*/index.js"
      ],
      "@smthrs/time-travel": [
        "./packages/time-travel/src/index.js"
      ],
      "@smthrs/time-travel/*": [
        "./packages/time-travel/src/*.js",
        "./packages/time-travel/src/*/index.js"
      ],
      "@smthrs/vcs": [
        "./packages/vcs/src/index.js"
      ],
      "@smthrs/vcs/*": [
        "./packages/vcs/src/*.js",
        "./packages/vcs/src/*/index.js"
      ],
      "@smthrs/accounts": [
        "./packages/accounts/src/index.js"
      ],
      "@smthrs/accounts/*": [
        "./packages/accounts/src/*.js",
        "./packages/accounts/src/*/index.js"
      ],
      "@smthrs/usage": [
        "./packages/usage/src/publicTypes.ts",
        "./packages/usage/src/index.js"
      ],
      "@smthrs/usage/*": [
        "./packages/usage/src/*.js",
        "./packages/usage/src/*/index.js"
      ],
      "@smthrs/testing": [
        "./packages/testing/src/index.ts"
      ],
      "@smthrs/testing/*": [
        "./packages/testing/src/*.ts"
      ],
      "@smthrs/tool-context": [
        "./packages/tool-context/src/index.js"
      ],
      "@smthrs/tool-context/*": [
        "./packages/tool-context/src/*.js",
        "./packages/tool-context/src/*/index.js"
      ]
    },
    "typeRoots": [
      "./packages/smithers/src/types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "packages/smithers/src/**/*",
    "packages/smithers/tests/**/*"
  ],
  "exclude": [
    "packages/smithers/src/gateway-ui.js",
    "packages/smithers/src/gateway-ui.d.ts",
    "packages/smithers/src/ui.js",
    "packages/smithers/src/ui.d.ts"
