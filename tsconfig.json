{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "smthrs",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "smthrs": [
        "./packages/smithers/src/index.js"
      ],
      "smthrs/jsx-runtime": [
        "./packages/smithers/src/jsx-runtime.js"
      ],
      "smthrs/jsx-dev-runtime": [
        "./packages/smithers/src/jsx-runtime.js"
      ],
      "smthrs/tools": [
        "./packages/smithers/src/tools.js"
      ],
      "smthrs/testing": [
        "./packages/smithers/src/testing.d.ts"
      ],
      "smthrs/cloudflare": [
        "./packages/smithers/src/cloudflare.js"
      ],
      "smthrs/browser": [
        "./packages/smithers/src/browser.d.ts"
      ],
      "smthrs/*": [
        "./packages/smithers/src/*.js",
        "./packages/smithers/src/*/index.js"
      ],
      "smthrs/scorers": [
        "./packages/scorers/src/index.js"
      ],
      "@smthrs/agents": [
        "./packages/agents/src/index.js"
      ],
      "@smthrs/agents/*": [
        "./packages/agents/src/*.js",
        "./packages/agents/src/*/index.js"
      ],
      "@smthrs/cli": [
        "./apps/cli/src/index.js"
      ],
      "@smthrs/cli/*": [
        "./apps/cli/src/*.js",
        "./apps/cli/src/*/index.js"
      ],
      "@smthrs/cloudflare": [
        "./packages/cloudflare/src/index.js"
      ],
      "@smthrs/cloudflare/*": [
        "./packages/cloudflare/src/*.js"
      ],
      "@smthrs/core-react": [
        "./packages/react/src/index.js"
      ],
      "@smthrs/core-react/*": [
        "./packages/react/src/*.js",
        "./packages/react/src/*/index.js"
      ],
      "@smthrs/db": [
        "./packages/db/src/index.ts",
        "./packages/db/src/index.js"
      ],
      "@smthrs/db/runState": [
        "./packages/db/src/runState.js",
        "./packages/db/src/runState.d.ts"
      ],
      "@smthrs/db/*": [
        "./packages/db/src/*.ts",
        "./packages/db/src/*.js",
        "./packages/db/src/*/index.js"
      ],
      "@smthrs/devtools": [
        "./packages/devtools/src/index.js"
      ],
      "@smthrs/devtools/*": [
        "./packages/devtools/src/*.ts",
        "./packages/devtools/src/*.js",
        "./packages/devtools/src/*/index.js"
      ],
      "@smthrs/driver": [
        "./packages/driver/src/index.js"
      ],
      "@smthrs/driver/*": [
        "./packages/driver/src/*.ts",
        "./packages/driver/src/*.js",
        "./packages/driver/src/*/index.js"
      ],
      "@smthrs/electric-proxy": [
        "./packages/electric-proxy/src/index.ts"
      ],
